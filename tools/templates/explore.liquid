{%- comment -%}
  The /explore/ pages: a group of commits (ex: a bug's) and the files they
  touched, with a sparkline per file with a narrow slot per commit, and under
  each, if `outlines`, its outline diff's definitions which changed (see
  explore_file.liquid), or else, as a dense "horizontal Southern blot", a
  sparkline per symbol (ex: history pages', of their scopes' changes).
  Symbols with nested symbols (ex: classes) are collapsed into their sparkline
  with a thin row per nested symbol and a count of them, and expand into
  labeled sparklines.  The sparklines are SVGs generated by
  `hyperblame::explore`, and explore.js shows the commit under the mouse.  The
  files are grouped by path kind, and facets (see facet_bar.liquid, in the
  navigation panel) filter them by path kind, subsystem, and directory, or
  group them by another, or sort them by their changes' sizes.  The keys'
  commits on other branches (ex: uplifts) are listed too.  See
  `format::format_explore`.
{%- endcomment -%}
{%- comment %}(The navigation panel, expanded with the facets filtering the
files, if there are any; see facet_bar.liquid.){% endcomment %}
{%- if commits.size > 0 %}
{% include 'navigation_panel.liquid' expanded: true, panel: null, panel_facets: facets, panel_group_by: true, panel_sort_by: true %}
{%- else %}
{% include 'navigation_panel.liquid' expanded: false, panel: null %}
{%- endif %}
<div class="explore-page" data-slot="{{ slot }}">
  <h2>{{ title | escape }}</h2>
  {%- if scopes.size > 0 %}
  <p class="explore-scopes">{% for scope in scopes %}{% if scope.url %}<a href="{{ scope.url | escape }}">{{ scope.label | escape }}</a>{% else %}<strong>{{ scope.label | escape }}</strong>{% endif %}{% unless forloop.last %} › {% endunless %}{% endfor %}</p>
  {%- endif %}
  {%- if note %}
  <p class="explore-note">{{ note | escape }}</p>
  {%- endif %}
  {%- if landed.size > 0 %}
  <div class="explore-note explore-landed">{% if landed.size == 1 %}One of its commits has{% else %}{{ landed.size }} of its commits have{% endif %} landed since it diverged from the trunk, so its semantic analysis leaves {% if landed.size == 1 %}it{% else %}them{% endif %} out:
    <ul>
      {%- for commit in landed %}
      <li><a href="/{{tree}}/commit/{{ commit.rev | escape }}">{{ commit.summary | escape }}</a>, as <a class="explore-landed-as" href="/{{tree}}/commit/{{ commit.landed | escape }}">{{ commit.landed | slice: 0, 12 }}</a>{% unless commit.same_changes %} (the same Phabricator revision, which may have changed before it landed: {{ commit.landed_summary | escape }}){% endunless %}</li>
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}
  {%- if semantic_failure %}
  {%- if semantic_failure.all_landed %}
  <p class="explore-note explore-semantic-failure">All of its commits (but those selecting try's tasks) have landed, so there's nothing for its semantic analysis to analyze: the indexed revision has its changes.</p>
  {%- else %}
  <p class="explore-note explore-semantic-failure">Its semantic analysis, for jumps and references in what it changes, failed in its <code>{{ semantic_failure.step | escape }}</code> step{% if semantic_failure.error %}: {{ semantic_failure.error | escape }}{% else %}.{% endif %}{% if semantic_failure.conflicting_commit %} The commit whose changes conflict: {{ semantic_failure.conflicting_commit | escape }}.{% endif %}{% if semantic_failure.conflicts.size > 0 %} The files whose changes conflict: {{ semantic_failure.conflicts | join: ", " | escape }}.{% endif %}</p>
  {%- endif %}
  {%- endif %}
  {%- if semantic_head %}
  <p class="explore-note explore-semantic-head">Its stack rebased onto the indexed revision has semantic analysis: <a href="/{{tree}}/rev/{{ semantic_head | escape }}/">browse it</a>, with jumps and references, where searches (like this page's) are of the push, or see <a class="explore-canvas" href="/{{tree}}/rev-canvas/{{ semantic_head | escape }}">the functions it adds or changes and their calls on a canvas</a>.</p>
  {%- endif %}
  {%- if missing.size > 0 %}
  <p class="explore-note">No commits {% if other_branches.size > 0 %}on this branch {% endif %}mention {{ missing | join: ", " | escape }}.</p>
  {%- endif %}
  {%- if truncated %}
  <p class="explore-note">Only the first {{ commits.size }} commits are shown.</p>
  {%- endif %}
  {%- if other_branches.size > 0 %}
  <details class="explore-other-branches">
    <summary>Also on other branches: {% for other in other_branches %}{{ other.branch | escape }} ({{ other.commits.size }}){% unless forloop.last %}, {% endunless %}{% endfor %}</summary>
    {%- for other in other_branches %}
    <h3>{{ other.branch | escape }}{% if other.tree %} (<a href="/{{ other.tree }}/{{ explore_url }}">{{ other.tree }}</a>){% endif %}</h3>
    <ol>
      {%- for commit in other.commits %}
      <li class="explore-commit{% if commit.backout %} explore-backout{% endif %}">
        <span class="explore-commit-summary">{{ commit.summary }}</span>
        <span class="explore-commit-date">{{ commit.isoDate | slice: 0, 10 }}</span>
        <a href="/{{ other.link_tree }}/commit/{{ commit.rev }}">{{ commit.rev | slice: 0, 12 }}</a>
      </li>
      {%- endfor %}
    </ol>
    {%- endfor %}
  </details>
  {%- endif %}
  {%- if commits.size > 0 %}
  <details class="explore-commit-list"{% if commits.size <= 12 %} open{% endif %}>
    <summary>{{ commits.size }} commit{% if commits.size != 1 %}s{% endif %}, oldest first</summary>
    <ol>
      {%- for commit in commits %}
      <li id="commit-{{ commit.number }}" class="explore-commit{% if commit.backout %} explore-backout{% endif %}">
        <span class="explore-pick"><input type="checkbox" class="explore-pick-a" value="{{ commit.rev }}" title="Side A of an interdiff"><input type="checkbox" class="explore-pick-b" value="{{ commit.rev }}" title="Side B of an interdiff"></span>
        {%- if commit.interdiff %}
        <a class="explore-interdiff" href="{{ commit.interdiff }}" title="How the reland differs from the commits this backed out">interdiff of the reland</a>
        {%- endif %}
        <span class="explore-commit-summary">{{ commit.summary }}</span>
        <span class="explore-commit-date">{{ commit.isoDate | slice: 0, 10 }}</span>
        <a href="/{{ tree }}/commit/{{ commit.rev }}">{{ commit.rev | slice: 0, 12 }}</a>
      </li>
      {%- endfor %}
    </ol>
    <p class="explore-note explore-interdiff-picker">Check commits as side A and side B (the boxes before them) to see <a class="explore-interdiff-link">how B differs from A</a>, ex: a reland from the landing it relands.</p>
  </details>
  <p class="explore-status explore-note">{% if outlines %}Each file's sparkline has a slot per commit, filled (darker for more tokens) if the commit changed it.  Hover over them to see which commit is which.  Under them are the definitions which changed, with the tokens added and removed, and the commits which changed them.{% else %}Each sparkline has a slot per commit, filled (darker for more tokens) if the commit changed it.  Hover over them to see which commit is which, and expand classes to see their members.{% endif %}</p>
  {%- include "explore_file_groups.liquid" %}
  {%- endif %}
</div>
<script src="/{{ tree }}/static/js/explore.js"></script>
