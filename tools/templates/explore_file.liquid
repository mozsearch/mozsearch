{%- comment -%}
  A file of an /explore/ page (see explore.liquid) or of an interdiff's summary
  (see interdiff_files.liquid): its sparkline, and its outline diff's
  definitions which changed (see `format::explore_outlines`), nested in the
  ones they're in, with their changes and the commits which made them, or
  without one, its symbols' sparklines (expandable for symbols with nested
  symbols), with their moves to and from other files in the commits (see
  `explore::annotate_moves`).  Interdiffs fade the files and symbols whose
  changes are the same in both patches, and add a note and excerpts.
{%- endcomment -%}
  <section class="explore-file{% if file.same %} interdiff-same{% endif %}" data-path="{{ file.path | escape }}" data-facets="{{ file.facets | escape }}" data-groups="{{ file.groups | escape }}"{% if file.change_size %} data-size="{{ file.change_size }}"{% endif %}>
    <div class="explore-file-header"><a href="{{ file.link }}"{% if file.title != "" %} title="{{ file.title | escape }}"{% endif %}>{{ file.path | escape }}</a> {{ file.sparkline }}{% if file.outline != "" %} <a class="explore-outline" href="{{ file.outline }}" title="How the file's definitions changed across these commits (and any between them)">outline</a>{% endif %}{% if file.note != "" %} <span class="interdiff-file-note">{{ file.note }}</span>{% endif %}</div>
    {%- if file.outline_rows %}
    {%- if file.outline_rows.size > 0 %}
    <table class="explore-outline-rows">
      {%- for row in file.outline_rows %}
      <tr class="outline-{{ row.status }}{% if row.context %} outline-context{% endif %}" style="--outline-depth: {{ row.depth }}" title="{{ row.title | escape }}">
        <td class="explore-outline-name">{% if row.link %}<a href="{{ row.link }}">{{ row.name | escape }}</a>{% else %}{{ row.name | escape }}{% endif %}{% if row.note %} <span class="outline-diff-note">{{ row.note | escape }}</span>{% endif %}</td>
        <td class="explore-outline-change">{% if row.badge != "" %}<span class="outline-badge">{{ row.badge | escape }}</span>{% endif %}{% for commit in row.commits %} <a class="outline-diff-commit" href="{{ commit.link }}" title="{{ commit.title | escape }}">{{ commit.label }}</a>{% endfor %}</td>
      </tr>
      {%- endfor %}
    </table>
    {%- endif %}
    {%- elsif file.symbols.size > 0 %}
    <div class="explore-symbols">
      {%- for symbol in file.symbols %}
      {%- if symbol.children.size > 0 %}
      <details class="explore-symbol explore-parent{% if symbol.same %} interdiff-same{% endif %}">
        <summary title="{{ symbol.pretty | escape }}"><span class="explore-summary"><span class="explore-name">{{ symbol.name | escape }}</span>{% for move in symbol.moves %} <a class="explore-move" href="{{ move.link }}" title="{{ move.title | escape }}">{{ move.label | escape }}</a>{% endfor %} <span class="explore-count">({{ symbol.children.size }})</span> <span class="explore-collapsed">{{ symbol.blot }}</span><span class="explore-expanded">{{ symbol.sparkline }}</span></span></summary>
        <div class="explore-children">
          {%- for child in symbol.children %}
          <span class="explore-symbol explore-child{% if child.same %} interdiff-same{% endif %}" title="{{ child.pretty | escape }}"><span class="explore-name">{{ child.name | escape }}</span>{% for move in child.moves %} <a class="explore-move" href="{{ move.link }}" title="{{ move.title | escape }}">{{ move.label | escape }}</a>{% endfor %} {{ child.sparkline }}</span>
          {%- endfor %}
        </div>
      </details>
      {%- else %}
      <span class="explore-symbol{% if symbol.same %} interdiff-same{% endif %}" title="{{ symbol.pretty | escape }}"><span class="explore-name">{{ symbol.name | escape }}</span>{% for move in symbol.moves %} <a class="explore-move" href="{{ move.link }}" title="{{ move.title | escape }}">{{ move.label | escape }}</a>{% endfor %} {{ symbol.sparkline }}</span>
      {%- endif %}
      {%- endfor %}
    </div>
    {%- endif %}
    {{ file.excerpts }}
  </section>
