{%- comment %} (Forward declarations start collapsed.  The group's relation to
the queried symbols, if the results have several, is its files' and lines'
"relation" facet's value; see facets.js.  And its counts, which its path
kind's add up from its shown groups'; see query-results.js.) {% endcomment -%}
{%- if kind_group contains "relation" -%}
{%- capture relation_scope %}{"relation":["{{ kind_group.relation }}"]}{% endcapture -%}
{%- endif -%}
{%- comment -%}
  Textual occurrences on lines that other results already show (for
  their other matches; `repeated`) are hidden unless the checkbox (whose
  setting query-results.js remembers) says otherwise, and aren't in the
  counts.
{%- endcomment -%}
{%- assign kind_lines = 0 -%}
{%- assign kind_files = 0 -%}
{%- assign kind_repeated = 0 -%}
{%- for file_results in kind_group.by_file -%}
    {%- assign file_lines = 0 -%}
    {%- for line_span in file_results.line_spans -%}
        {%- if line_span contains "repeated" -%}
            {%- assign kind_repeated = kind_repeated | plus: 1 -%}
        {%- else -%}
            {%- assign file_lines = file_lines | plus: 1 -%}
        {%- endif -%}
    {%- endfor -%}
    {%- if file_lines > 0 %}{% assign kind_files = kind_files | plus: 1 %}{% endif -%}
    {%- assign kind_lines = kind_lines | plus: file_lines -%}
{%- endfor %}
<details{% if kind_group.kind != "ForwardDeclarations" %} open{% endif %} class="facet-group"{% if kind_group contains "relation" %} data-facet-scope="{{ relation_scope | escape }}"{% endif %} data-lines="{{ kind_lines | escape }}" data-files="{{ kind_files | escape }}">
    {%- comment %} (Only the triangle and the kind toggle it; see query-results.js.  The kinds' names are router.py's, and their relations to the queried symbols say how their symbols, named after them, are; see `ResultRelation`.) {% endcomment %}
    {%- assign relation = "self" -%}
    {%- if kind_group contains "relation" %}{% assign relation = kind_group.relation %}{% endif %}
    {%- assign super_calls = false -%}
    {%- if relation == "overridden" and kind_group.kind == "Uses" %}{% assign super_calls = true %}{% endif %}
    <summary><h2><span class="query-toggle">
        {%- if relation == "virtual-uses" -%}
            Possible virtual calls
        {%- elsif super_calls -%}
            Super calls
        {%- else -%}
        {%- case kind_group.kind -%}
            {%- when "IDLPartial" -%}
                IDL Partial
            {%- when "TextualOccurrences" -%}
                Textual Occurrences
            {%- when "ForwardDeclarations" -%}
                Forward Declarations
            {%- when "DocDefinitions" -%}
                Documentation
            {%- when "DocUses" -%}
                Documentation References
            {%- else -%}
                {{ kind_group.kind | escape }}
        {%- endcase -%}
        {%- case relation -%}
            {%- when "overridden" %} of what it overrides
            {%- when "overrides" %} of its overrides
            {%- when "cousins" %} of cousin overrides
        {%- endcase -%}
        {%- endif -%}
    </span>{% if kind_group.pretty != empty %} ({% if relation == "virtual-uses" or super_calls %}uses of {% endif %}{{ kind_group.pretty | escape }}{% if super_calls %} in its overrides{% endif %}){% endif %}
    {%- include 'query_results/counts.liquid' file_names: 0, lines: kind_lines, files: kind_files %}</h2>
    {%- if kind_repeated > 0 %} <label class="query-repeated-toggle"><input type="checkbox"> Include {{ kind_repeated | escape }} line{% if kind_repeated != 1 %}s{% endif %} already shown by other results</label>{% endif -%}
    </summary>
    {%- comment %} (The results' facets cover the "Path" facet.) {% endcomment -%}
    {%- for facet in kind_group.facets -%}
    {%- if facet.kind != "PathByPath" -%}
    {% include 'query_results/facet_root.liquid' facet: facet, forloop: forloop %}
    {%- endif -%}
    {%- endfor -%}
    {%- for file_results in kind_group.by_file -%}
    {% include 'query_results/file_results.liquid' file_results: file_results, forloop: forloop %}
    {%- endfor -%}
</details>
