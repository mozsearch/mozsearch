{%- comment %} (Forward declarations start collapsed.) {% endcomment -%}
<details{% if kind_group.kind != "ForwardDeclarations" %} open{% endif %} class="facet-group">
    {%- comment -%}
      Textual occurrences on lines that other results already show (for
      their other matches; `repeated`) are hidden unless the checkbox (whose
      setting query-results.js remembers) says otherwise, and aren't in the
      counts.
    {%- endcomment -%}
    {%- assign kind_lines = 0 -%}
    {%- assign kind_files = 0 -%}
    {%- assign kind_repeated = 0 -%}
    {%- for file_results in kind_group.by_file -%}
        {%- assign file_lines = 0 -%}
        {%- for line_span in file_results.line_spans -%}
            {%- if line_span contains "repeated" -%}
                {%- assign kind_repeated = kind_repeated | plus: 1 -%}
            {%- else -%}
                {%- assign file_lines = file_lines | plus: 1 -%}
            {%- endif -%}
        {%- endfor -%}
        {%- if file_lines > 0 %}{% assign kind_files = kind_files | plus: 1 %}{% endif -%}
        {%- assign kind_lines = kind_lines | plus: file_lines -%}
    {%- endfor %}
    {%- comment %} (Only the triangle and the kind toggle it; see query-results.js.  The kinds' names are router.py's.) {% endcomment %}
    <summary><h2><span class="query-toggle">
        {%- case kind_group.kind -%}
            {%- when "IDLPartial" -%}
                IDL Partial
            {%- when "TextualOccurrences" -%}
                Textual Occurrences
            {%- when "ForwardDeclarations" -%}
                Forward Declarations
            {%- else -%}
                {{ kind_group.kind }}
        {%- endcase -%}
    </span>{% if kind_group.pretty != empty %} ({{ kind_group.pretty }}){% endif %}
    {%- include 'query_results/counts.liquid' file_names: 0, lines: kind_lines, files: kind_files %}</h2>
    {%- if kind_repeated > 0 %} <label class="query-repeated-toggle"><input type="checkbox"> Include {{ kind_repeated }} line{% if kind_repeated != 1 %}s{% endif %} already shown by other results</label>{% endif -%}
    </summary>
    {%- comment %} (The results' facets cover the "Path" facet.) {% endcomment -%}
    {%- for facet in kind_group.facets -%}
    {%- if facet.kind != "PathByPath" -%}
    {% include 'query_results/facet_root.liquid' facet: facet, forloop: forloop %}
    {%- endif -%}
    {%- endfor -%}
    {%- for file_results in kind_group.by_file -%}
    {% include 'query_results/file_results.liquid' file_results: file_results, forloop: forloop %}
    {%- endfor -%}
</details>
