{%- comment -%}
  A history grep's page (`text-history:`, `re-history:`; see
  hyperblame/history_grep.rs): the revisions where the matches of its pattern
  in a file changed, newest first.
{%- endcomment -%}
{%- assign grep = results.HistoryGrep -%}
{%- assign base_query = query | split: " page:" | first -%}
<div class="history-grep">
{%- if grep.unsupported %}
  <p>This tree has no history to search.</p>
{%- else %}
  <h2>
    {% if grep.timeline %}How matches of{% else %}Where matches of{% endif %}
    {% if grep.text %}<code>{{ grep.text | escape }}</code>{% else %}<code>/{{ grep.pattern | escape }}/</code>{% endif %}
    changed{% if grep.timeline %} over time{% endif %}
  </h2>
  <p class="history-grep-plan">
    {%- if grep.tokens != empty %}
    Checking the {{ grep.candidates }} revision{% if grep.candidates != 1 %}s{% endif %} which changed
    {% for token in grep.tokens %}<a href="/{{ tree }}/query/default?q=token-history%3A{{ token | url_encode }}"><code>{{ token | escape }}</code></a>{% unless forloop.last %}, {% endunless %}{% endfor %},
    which every match contains.
    {%- else %}
    {%- assign file_count = grep.files | size %}
    Checking the {{ grep.candidates }} revision{% if grep.candidates != 1 %}s{% endif %} of
    {{ file_count }} file{% if file_count != 1 %}s{% endif %}
    {%- if grep.scope %} which changed <code>{{ grep.scope | escape }}</code>, on its lines
    {%- if grep.pruned %} (those changing the pattern's names in it: it changed too often to check every revision){% endif %}
    {%- endif %}.
    {%- endif %}
    This page checked revisions {{ grep.page_start | plus: 1 }}–{{ grep.page_end }}
    ({{ grep.checked }} file version{% if grep.checked != 1 %}s{% endif %}).
    {%- if grep.merges_skipped > 0 %} Merges are skipped ({{ grep.merges_skipped }}).{% endif %}
    {%- if grep.backouts_hidden > 0 %}
    {{ grep.backouts_hidden }} backed out change{% if grep.backouts_hidden != 1 %}s{% endif %} and {% if grep.backouts_hidden != 1 %}their backouts are{% else %}its backout are{% endif %} left out
    (<a href="/{{ tree }}/query/{{ preset }}?q={{ base_query | append: " backouts:show" | url_encode }}">show them</a>).
    {%- endif %}
    {%- if grep.out_of_time %} This page stopped at its time limit.{% endif %}
  </p>
  {%- if grep.ignored %}
  <p class="history-grep-ignored">Ignored <code>{{ grep.ignored | escape }}</code>: a history query only takes its terms (ex: <code>until:YYYY-MM-DD</code>, <code>path:</code>, <code>scope:</code>).</p>
  {%- endif %}
  {%- if grep.timeline %}
  {%- comment %}(The timeline's model, with its "<"s escaped; see history-timeline.js.){% endcomment %}
  <script>var HISTORY_TIMELINE = {{ grep.timeline | json | replace: "<", "\u003c" }};</script>
  <div id="history-timeline" class="history-timeline"></div>
  <script defer src="/{{ tree }}/static/js/history-timeline.js"></script>
  {%- for series in grep.timeline.series %}
  <table class="history-grep-table history-timeline-table">
    <caption>
      {%- if series.label != "" %}<code>{{ series.label | escape }}</code>: {% endif -%}
      {%- case grep.timeline.measure %}
      {%- when "value" %}its value
      {%- when "values" %}how many distinct values the matches captured
      {%- else %}how many matches
      {%- endcase %}, from {{ series.start }}
    </caption>
    <thead>
      <tr><th>Date</th><th>Revision</th><th>Then</th><th>Changes</th></tr>
    </thead>
    <tbody>
      {%- for point in series.points %}
      <tr>
        <td class="history-grep-date"{% if point.committed %} title="Committed {{ point.committed }}"{% endif %}>{{ point.date }}</td>
        <td class="history-grep-commit"><a href="/{{ tree }}/commit/{{ point.rev }}"><code>{{ point.rev | slice: 0, 12 }}</code></a> {{ point.header }}</td>
        <td class="history-grep-count">{{ point.value }}</td>
        <td>
          {%- for added in point.added %}<div class="history-grep-added">+ <code>{{ added | escape }}</code></div>{% endfor -%}
          {%- for removed in point.removed %}<div class="history-grep-removed">− <code>{{ removed | escape }}</code></div>{% endfor -%}
        </td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>
  {%- endfor %}
  {%- endif %}
  {%- if grep.rows == empty %}
  <p>No changes to its matches in these revisions.</p>
  {%- else %}
  {%- if grep.timeline %}<details class="history-grep-files"><summary>By file</summary>{% endif %}
  <table class="history-grep-table">
    <thead>
      <tr><th>Date</th><th>Revision</th><th>File</th><th>Matches</th><th>Changes</th></tr>
    </thead>
    <tbody>
      {%- for row in grep.rows %}
      <tr{% if row.backout %} class="history-grep-backout"{% endif %}>
        <td class="history-grep-date"{% if row.committed %} title="Committed {{ row.committed }}"{% endif %}>{{ row.date }}</td>
        <td class="history-grep-commit"><a href="/{{ tree }}/commit/{{ row.rev }}"><code>{{ row.rev | slice: 0, 12 }}</code></a> {{ row.header }}</td>
        <td><a href="/{{ tree }}/rev/{{ row.rev }}/{{ row.path | escape }}">{{ row.path | escape }}</a>
          {%- if row.old_path %} (from {{ row.old_path | escape }}){% endif %}</td>
        <td class="history-grep-count">{{ row.before }} → {{ row.after }}</td>
        <td>
          {%- for value in row.added_values %}<div class="history-grep-added">+ {% for part in value %}<code>{{ part | escape }}</code>{% unless forloop.last %}, {% endunless %}{% endfor %}</div>{% endfor -%}
          {%- for value in row.removed_values %}<div class="history-grep-removed">− {% for part in value %}<code>{{ part | escape }}</code>{% unless forloop.last %}, {% endunless %}{% endfor %}</div>{% endfor -%}
          {%- if row.added_values == empty and row.removed_values == empty %}
          {%- for line in row.added_lines %}<div class="history-grep-added">+ <code>{{ line | escape }}</code></div>{% endfor -%}
          {%- for line in row.removed_lines %}<div class="history-grep-removed">− <code>{{ line | escape }}</code></div>{% endfor -%}
          {%- endif %}
        </td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>
  {%- if grep.timeline %}</details>{% endif %}
  {%- endif %}
  {%- if grep.next_page %}
  <p><a href="/{{ tree }}/query/{{ preset }}?q={{ base_query | append: " page:" | append: grep.next_page | url_encode }}">Keep going</a> (revisions {{ grep.next_page | plus: 1 }}–{{ grep.candidates }} of the candidates).</p>
  {%- endif %}
  <p class="history-grep-caveats">
    Code moved between files isn't a change here, and merges are skipped.
    {%- if grep.tokens != empty %} Matches in prose in strings, URLs and paths, which the history doesn't track by name, can be missed; with a <code>path:</code> naming a few files, their every revision can be checked.{% endif %}
  </p>
{%- endif %}
</div>
