{%- comment -%}
  The counts are /search/'s: the file name matches, and the kinds' lines and
  files (a file counts once per kind it's in), without the textual
  occurrences on lines that other results already show (see
  kind_group.liquid).
{%- endcomment -%}
{%- assign pk_lines = 0 -%}
{%- assign pk_files = pk_group.file_names.size -%}
{%- for kind_group in pk_group.kind_groups -%}
    {%- for file_results in kind_group.by_file -%}
        {%- assign file_lines = 0 -%}
        {%- for line_span in file_results.line_spans -%}
            {%- unless line_span contains "repeated" %}{% assign file_lines = file_lines | plus: 1 %}{% endunless -%}
        {%- endfor -%}
        {%- if file_lines > 0 %}{% assign pk_files = pk_files | plus: 1 %}{% endif -%}
        {%- assign pk_lines = pk_lines | plus: file_lines -%}
    {%- endfor -%}
{%- endfor -%}
<details open class="facet-group">
    <summary><h1><span class="query-toggle">
        {%- case pk_group.path_kind -%}
            {%- when "normal" -%}
                Normal Results
            {%- when "third_party" -%}
                Third-party code
            {%- when "test" -%}
                Test files
            {%- when "generated" -%}
                Generated code
        {%- endcase -%}
    </span>{% include 'query_results/counts.liquid' file_names: pk_group.file_names.size, lines: pk_lines, files: pk_files %}</h1></summary>
    {% if pk_group.file_names != empty -%}
        <details open class="facet-group">
            <summary><h2><span class="query-toggle">Files</span>{% include 'query_results/counts.liquid' file_names: 0, lines: 0, files: pk_group.file_names.size %}</h2></summary>
            {%- comment %} (With their files' history digests, if they have them; see `FileRecency`.) {% endcomment %}
            {%- assign file_recency = "" -%}
            {%- if results.FlattenedResultsBundle contains "file_recency" -%}
            {%- assign file_recency = results.FlattenedResultsBundle.file_recency -%}
            {%- endif %}
            <ul class="query-file-names">
            {%- for path in pk_group.file_names %}
                {%- assign facet_data = file_facets.files[path] %}
                <li{% if facet_data %} data-path="{{ path | escape }}" data-facets="{{ facet_data.facets | escape }}" data-groups="{{ facet_data.groups | escape }}"{% endif %}>{% include 'path.liquid' path: path %}{% if file_recency != empty and file_recency contains path %} {{ file_recency[path] | recency_blot: path }}{% endif %}</li>
            {%- endfor %}
            </ul>
        </details>
    {%- endif %}
    {% for kind_group in pk_group.kind_groups %}
    {% include 'query_results/kind_group.liquid' kind_group: kind_group, forloop: forloop %}
    {% endfor %}
</details>
