<details open class="facet-group">
    <summary><h1><span class="query-toggle">
        {%- case pk_group.path_kind -%}
            {%- when "normal" -%}
                Normal Results
            {%- when "third_party" -%}
                Third-party code
            {%- when "test" -%}
                Test files
            {%- when "generated" -%}
                Generated code
        {%- endcase -%}
    </span></h1></summary>
    {% if pk_group.file_names.length -%}
        <details open class="facet-group">
            <summary><span class="query-toggle">Files</span></summary>
            <li>
            {% for path in pk_group.file_names %}
                {%- assign facet_data = file_facets.files[path] %}
                <div{% if facet_data %} data-path="{{ path | escape }}" data-facets="{{ facet_data.facets | escape }}" data-groups="{{ facet_data.groups | escape }}"{% endif %}>{% include 'path.liquid' path: path %}</div>
            {% endfor %}
            </li>
        </details>
    {%- endif %}
    {% for kind_group in pk_group.kind_groups %}
    {% include 'query_results/kind_group.liquid' kind_group: kind_group, forloop: forloop %}
    {% endfor %}
</details>
