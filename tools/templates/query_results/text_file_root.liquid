{% if results.TextFile.mime_type == "image/svg+xml" %}
    {{ results.TextFile.contents }}
{% elsif results.TextFile.mime_type == "application/vnd.searchfox.subway+json" %}
{%- comment %}(A subway map's model, with its "<"s escaped; see subway.js.){% endcomment %}
<script>var SUBWAY = {{ results.TextFile.contents }}; var GRAPH_EXTRA = [];</script>
<div id="interactive-graph-base" class="sw-base">
<div id="interactive-graph-viewport">
<div id="interactive-graph-container">
</div>
</div>
<div id="sw-legend" class="sw-legend"></div>
</div>
<script src="/{{tree}}/static/js/graph.js"></script>
<script src="/{{tree}}/static/js/subway.js"></script>
{% elsif results.TextFile.mime_type == "application/vnd.searchfox.token-timeline+json" %}
{%- comment %}(Tokens' timelines' model, with its "<"s escaped; see token-timeline.js.){% endcomment %}
<script>var TOKEN_TIMELINE = {{ results.TextFile.contents }};</script>
<div id="token-timeline" class="token-timeline"></div>
<script defer src="/{{tree}}/static/js/token-timeline.js"></script>
{% elsif results.TextFile.mime_type == "application/vnd.searchfox.crash-stack+html" %}
{%- comment %}(The crash view; see crash_stack.rs.){% endcomment %}
    {{ results.TextFile.contents }}
{% elsif results.TextFile.mime_type == "application/vnd.searchfox.bug-comment+html" %}
{%- comment %}(A Bugzilla comment's view; see bug_comment.rs.){% endcomment %}
    {{ results.TextFile.contents }}
{% elsif results.TextFile.mime_type == "application/vnd.searchfox.rev-at+html" %}
{%- comment %}(The head a tree's branch had at a time; see cmd_rev_at.rs.){% endcomment %}
    {{ results.TextFile.contents }}
{% elsif results.TextFile.mime_type == "text/x-dot" %}
<pre>{{ results.TextFile.contents | escape }}</pre>
{% else %}
Unsupported MIME type: {{ results.TextFile.mime_type }}
{% endif %}
