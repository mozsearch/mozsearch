{%- if autofocus -%}
  {%- assign maybe_autofocus = "autofocus " -%}
{%- else -%}
  {%- assign maybe_autofocus = "" -%}
{%- endif -%}
  <!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="color-scheme" content="light dark">
  <link href="/{{tree}}/static/icons/search.png" rel="shortcut icon">
  <title>{{ title }}</title>
  <link rel="search" type="application/opensearchdescription+xml" href="/{{tree}}/opensearch.xml" title="Searchfox ({{tree}})">

  <link href="/{{tree}}/static/css/mozsearch.css" rel="stylesheet" media="screen"/>
  <link href="/{{tree}}/static/css/icons.css" rel="stylesheet" media="screen" />
  <link href="/{{tree}}/static/css/font-icons.css" rel="stylesheet" media="screen" />
  {%- comment %} (In the head, so that the page's layout can follow the settings as it loads; see `EarlyLayout` in settings.js and `output::generate_header`.) {% endcomment %}
  <script src="/{{tree}}/static/js/settings.js"></script>
</head>

<body>
<div id="fixed-header">
  {%- comment %}
    (A query's page's box has its query, in the query language, and searches
    with /query/ as it is, unlike other pages' boxes, which send what's typed
    to `/search`, see header_search.liquid; its additions get search.js's
    quoting.  In a tree searching with queries, it goes by `/search` as a
    query (`as=query`), for the DWIM rules which go somewhere at once, ex: a
    crash-stats report's URL to its crash view; see web-server.rs's `search`
    route.)
  {% endcomment %}
  {%- if query_search %}
  <form method="get" action="/{{tree}}/search" class="search-box" id="search-box">
  {%- else %}
  <form method="get" action="/{{tree}}/query/{{preset}}" class="search-box" id="search-box">
  {%- endif %}
  <fieldset>
    <div id="query-section">
      <label for="query" class="query_label visually-hidden">Find</label>
      <input type="text" name="q"  value="{{query | escape}}" maxlength="2048" id="query" accesskey="s" title="Search" placeholder="Search {{tree}}" autocomplete="off" {{ maybe_autofocus }}/>
      <div class="zero-size-container">
        <div class="bubble" id="query-bubble">
        </div>
      </div>
      <section id="spinner"></section>
    </div>
  </fieldset>
  <!-- We currently depend on the default submit behavior for Query so we do
        not mark this disabled like we do for "search" -->
  <input type="submit" value="Search" class="visually-hidden" />
  {%- if query_search %}
  <input type="hidden" name="as" value="query" />
  {%- if preset != "default" %}
  <input type="hidden" name="preset" value="{{ preset | escape }}" />
  {%- endif %}
  {%- endif %}
  {%- if search_rev != empty %}
  <!-- (Searching again stays in the try push's context.) -->
  <input type="hidden" name="rev" value="{{ search_rev | escape }}" />
  {%- endif %}
  </form>
  <span id="data" data-root="/" data-search="/{{tree}}/query/default" data-tree="{{tree}}"{% if search_rev != empty %} data-search-rev="{{ search_rev | escape }}"{% endif %}></span>
</div>
