{%- comment -%}
Summary of the CI results of a test, for the test info box of source pages.

Parameters:
- results: The "test_results" concise per-file info of the test.
- details: The "test_results" detailed per-file info of the test.
- path: The path of the test.
{%- endcomment -%}
{%- capture results_url %}https://tests.firefox.dev/test.html?test={{ path | url_encode }}{% endcapture -%}
{%- capture day_url %}{{ results_url }}#from={% endcapture -%}
{%- if results.runs > 0 -%}{%- assign runs_kind = "plain" -%}{%- else -%}{%- assign runs_kind = "zero" -%}{%- endif -%}
{%- assign pass_rate = "–" -%}
{%- assign pass_rate_kind = "zero" -%}
{%- if results contains "pass_rate" -%}
  {%- capture pass_rate %}{{ results.pass_rate }}%{% endcapture -%}
  {%- assign pass_rate_kind = "plain" -%}
  {%- if results.pass_rate == 100 -%}
    {%- assign pass_rate_kind = "good" -%}
  {%- elsif results.pass_rate < 90 -%}
    {%- assign pass_rate_kind = "bad" -%}
  {%- endif -%}
{%- endif -%}
{%- if results.failures > 0 -%}{%- assign failures_kind = "failures" -%}{%- else -%}{%- assign failures_kind = "zero" -%}{%- endif -%}
{%- if results.timeouts > 0 -%}{%- assign timeouts_kind = "timeouts" -%}{%- else -%}{%- assign timeouts_kind = "zero" -%}{%- endif -%}
{%- if results.crashes > 0 -%}{%- assign crashes_kind = "crashes" -%}{%- else -%}{%- assign crashes_kind = "zero" -%}{%- endif -%}
{%- if results.skips > 0 -%}{%- assign skips_kind = "skips" -%}{%- else -%}{%- assign skips_kind = "zero" -%}{%- endif %}
      <div class="test-results">
        <div class="test-results-header"><a href="{{ results_url }}" title="More details on tests.firefox.dev">CI results</a> <span class="test-results-period" title="{{ results.start_date }} to {{ results.end_date }}">over the last {{ results.days }} days</span></div>
{%- assign chart_count = 0 -%}
{%- if details.max_daily_issue_rate > 0 -%}{%- assign chart_count = chart_count | plus: 1 -%}{%- endif -%}
{%- if details.max_daily_skip_rate > 0 -%}{%- assign chart_count = chart_count | plus: 1 -%}{%- endif %}
        <div class="test-results-body">
        <a class="test-results-tiles" href="{{ results_url }}" title="More details on tests.firefox.dev">
          {%- include 'test_results/tile.liquid' label: "Runs", value: results.runs, kind: runs_kind -%}
          {%- include 'test_results/tile.liquid' label: "Pass", value: pass_rate, kind: pass_rate_kind -%}
          {%- include 'test_results/tile.liquid' label: "Failures", value: results.failures, kind: failures_kind -%}
          {%- include 'test_results/tile.liquid' label: "Timeouts", value: results.timeouts, kind: timeouts_kind -%}
          {%- include 'test_results/tile.liquid' label: "Crashes", value: results.crashes, kind: crashes_kind -%}
          {%- include 'test_results/tile.liquid' label: "Skips", value: results.skips, kind: skips_kind %}
        </a>
{%- if chart_count > 0 %}
        <div class="test-results-charts test-results-charts-{{ chart_count }}">
  {%- if details.max_daily_issue_rate > 0 %}
          <figure class="test-results-figure">
            <figcaption>Runs with issues per day (up to {{ details.max_daily_issue_rate }}%)</figcaption>
            {%- include 'test_results/daily_chart.liquid' results: results, values: details.daily_rates, series: "failures,timeouts,crashes", max: details.max_daily_issue_rate, unit: "%", counts: details.daily, height: 48, day_url: day_url %}
            {%- include 'test_results/axis.liquid' results: results %}
            <ul class="test-results-legend">
              {%- if results.failures > 0 %}<li><span class="test-results-swatch test-results-failures"></span>Failures</li>{% endif -%}
              {%- if results.timeouts > 0 %}<li><span class="test-results-swatch test-results-timeouts"></span>Timeouts</li>{% endif -%}
              {%- if results.crashes > 0 %}<li><span class="test-results-swatch test-results-crashes"></span>Crashes</li>{% endif -%}
            </ul>
          </figure>
  {%- endif -%}
  {%- if details.max_daily_skip_rate > 0 %}
          <figure class="test-results-figure">
            <figcaption>Scheduled runs skipped per day (up to {{ details.max_daily_skip_rate }}%)</figcaption>
            {%- include 'test_results/daily_chart.liquid' results: results, values: details.daily_rates, series: "skips", max: details.max_daily_skip_rate, unit: "%", counts: details.daily, height: 48, day_url: day_url %}
            {%- include 'test_results/axis.liquid' results: results %}
          </figure>
  {%- endif %}
        </div>
{%- endif %}
        </div>
      </div>
