{%- comment -%}
  An interdiff's summary (see `format::format_interdiff_files`): the sides'
  commits (with when they landed, and a diff of their messages), and each file
  either side changed, with the explore pages'
  sparklines (see explore_file.liquid), which have a slot for each of A's
  commits and then each of B's, faded where B's changes are the same as A's,
  and with excerpts of where they differ (see `format::interdiff_excerpts`),
  grouped and faceted like the /explore/ pages' (see facet_bar.liquid).
  explore.js shows the commit under the mouse.
{%- endcomment -%}
<div class="explore-page interdiff-page" data-slot="{{ slot }}">
  <h2>Interdiff</h2>
  <section class="interdiff-summary">
    <div class="interdiff-sides">
      {%- for side in sides %}
      <div>
        <h3>{{ side.name }}</h3>
        <ol start="{{ side.start }}">
          {%- for commit in side.commits %}
          <li id="commit-{{ commit.number }}" class="explore-commit"><span class="explore-commit-date" title="When it landed">{{ commit.isoDate | slice: 0, 16 | replace: "T", " " }} UTC</span> <a href="/{{ tree }}/commit/{{ commit.rev }}">{{ commit.rev | slice: 0, 12 }}</a> <span class="explore-commit-summary">{{ commit.summary }}</span></li>
          {%- endfor %}
        </ol>
      </div>
      {%- endfor %}
    </div>
    {%- if messages != "" %}
    <details class="interdiff-messages" open>
      <summary>The commit messages differ, in the words only in <del class="idiff-only-a">A's</del> or <ins class="idiff-new">B's</ins></summary>
      <pre>{{ messages }}</pre>
    </details>
    {%- else %}
    <p class="explore-note">The commit messages are the same.</p>
    {%- endif %}
    <p class="interdiff-legend">{{ legend }}</p>
    <p><a href="{{ swap }}">Swap A and B</a></p>
  </section>
  {%- include "facet_bar.liquid" group_by: true %}
  <p class="explore-status explore-note">Each file's sparkline has a slot for each of A's commits and then each of B's, filled if the commit changed it.  The files and symbols where B's changes are the same as A's are faded, and the others have excerpts of where they differ.</p>
  {%- include "explore_file_groups.liquid" %}
</div>
<script src="/{{ tree }}/static/js/explore.js"></script>
