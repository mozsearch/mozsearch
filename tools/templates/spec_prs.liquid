{%- comment -%}
  The pages of the summaries of the open pull requests of a tree of specs'
  spec repositories (see `format::format_spec_prs` and `spec_prs`): without
  `spec`, its repositories (their specs' directories, and their GitHub
  names), with how many pull requests each has (linking to their pages
  filtered to them; see facets.js's `facet-` parameters); with it, a
  repository's pull requests, with facets filtering them (see
  facet_bar.liquid; in the navigation panel, the "panel" `part`, the rest
  being the "page" part), links to its specs' renderings with all of the pull
  requests' changes beside them (`rendered`), and each pull request with its
  page as a try push (which imports it), its GitHub page, and what it changes
  (with links to the specs' renderings with only its changes beside them),
  and its import's status,
  with a button asking for the imports of those which need them (which POSTs
  to `imports.import_url`, with the numbers of those the facets show, if
  there aren't too many; `imports.batch` says whether all are few enough), and
  while some wait or run, polling their status (`imports.status_url`; see
  `format::format_spec_pr_imports`) until they're done, when the page
  reloads.  Both have their syncs' status, a button
  asking for one (which POSTs to `sync_url`), and while one waits or runs,
  poll its status (`status_url`; see `format::format_spec_prs_sync_status`)
  until it's done, when the page reloads.
{%- endcomment -%}
{%- if part == "panel" %}
{%- if spec and summary and prs.size > 0 %}
{%- include "facet_bar.liquid" facets: facets, group_by: false, sort_by: false, noun: "pull request", nouns: "pull requests" %}
{%- endif %}
{%- else %}
<div class="spec-prs" data-status-url="{{ status_url | escape }}">
  {%- if rendered.size == 1 and rendered_several == false %}
  <p class="spec-prs-rendered"><a class="spec-prs-rendered-link" href="{{ rendered.first.url | escape }}">Rendered spec with all of its pull requests</a></p>
  {%- elsif rendered.size > 0 %}
  <p class="spec-prs-rendered">Rendered specs with all of their pull requests: {% for each in rendered %}<a class="spec-prs-rendered-link" href="{{ each.url | escape }}" title="{{ each.count | escape }} of its pull requests change it">{{ each.name | escape }}</a> ({{ each.count | escape }}){% unless forloop.last %}, {% endunless %}{% endfor %}</p>
  {%- endif %}
  <div class="spec-prs-sync">
    {%- if notice %}
    <p class="spec-prs-notice">{{ notice | escape }}</p>
    {%- endif %}
    <p class="spec-prs-status">
    {%- if summary %}<a class="spec-prs-github" href="{{ summary.url | escape }}">{{ summary.repo | escape }}</a> on GitHub. Synced {{ summary.synced | escape }}{% if summary.snapshot %}, from GitHub's metadata as of {{ summary.snapshot | escape }}{% endif %}. {% endif -%}
    {%- case status.state -%}
    {%- when "queued" -%}
      Waiting to sync.
    {%- when "running" -%}
      Syncing ({{ status.seconds | escape }}s so far): <code>{{ status.step | escape }}</code>
    {%- when "idle" -%}
      {%- if status.error %}The last sync failed:{% endif -%}
    {%- endcase -%}
    </p>
    {%- if status.state == "idle" %}
    {%- if status.error %}
    <pre class="spec-prs-error">{{ status.error | escape }}</pre>
    {%- endif %}
    <form method="post" action="{{ sync_url | escape }}">
      <button type="submit" class="spec-prs-sync-button">Sync {% if spec %}its{% else %}their{% endif %} pull requests</button>
    </form>
    {%- endif %}
  </div>
  {%- if spec and imports.available %}
  <div class="spec-prs-imports" data-status-url="{{ imports.status_url | escape }}">
    <p class="spec-prs-imports-status">{{ imports.current | escape }} of its {{ imports.count | escape }} pull request{% if imports.count != 1 %}s{% endif %} {% if imports.current == 1 %}is{% else %}are{% endif %} imported at {% if imports.current == 1 %}its head{% else %}their heads{% endif %}
      {%- if imports.pending > 0 %}, {{ imports.pending | escape }} {% if imports.pending == 1 %}is{% else %}are{% endif %} waiting or importing{% endif %}
      {%- if imports.needed > 0 %}, and {{ imports.needed | escape }} {% if imports.needed == 1 %}isn't{% else %}aren't{% endif %}{% endif %}.
      <span class="spec-prs-import-limit"{% if imports.batch %} hidden{% endif %}>That's too many to import at once: filter them to at most {{ imports.max_batch | escape }}, or import them from their pages.</span></p>
    {%- if imports.needed > 0 %}
    <form method="post" action="{{ imports.import_url | escape }}" class="spec-prs-import-form" data-max-batch="{{ imports.max_batch | escape }}">
      <button type="submit" class="spec-prs-import-button"{% unless imports.batch %} hidden{% endunless %}>Import these pull requests</button>
    </form>
    <p class="spec-prs-import-note">Importing them processes their commits into this tree's history and renders and analyzes their changes (a Bikeshed spec's only render once they're imported), a few at a time, each taking seconds to a minute.</p>
    {%- endif %}
  </div>
  {%- endif %}
  {%- if spec %}
  {%- if summary %}
  {%- if prs.size > 0 %}
  <div class="facet-items spec-pr-list">
    {%- for pr in prs %}
    <section class="spec-pr" data-path="{{ pr.number | escape }}" data-facets="{{ pr.facets | escape }}" data-needed="{{ pr.import.needed | escape }}">
      <div class="spec-pr-header"><a class="spec-pr-title" href="/{{ tree }}/{{ pr.try_path | escape }}" title="Its page as a try push, which imports it into this tree">#{{ pr.number | escape }} {{ pr.title | escape }}</a>{% if pr.url %} <a class="spec-pr-github" href="{{ pr.url | escape }}">on GitHub</a>{% endif %} <span class="spec-pr-import" data-state="{{ pr.import.state | escape }}">{{ pr.import.text | escape }}</span></div>
      <div class="spec-pr-meta">{% if pr.author %}By {{ pr.author | escape }}{% if pr.updated %}, updated {{ pr.updated | escape }}{% endif %}{% elsif pr.updated %}Updated {{ pr.updated | escape }}{% endif %}{% if pr.review %} <span class="spec-pr-review spec-pr-review-{{ pr.review_class | escape }}">{{ pr.review_name | escape }}</span>{% endif %}{% if pr.draft %} <span class="spec-pr-draft">Draft</span>{% endif %}{% for label in pr.labels %} <span class="spec-pr-label">{{ label | escape }}</span>{% endfor %}</div>
      {%- if pr.error %}
      <p class="spec-pr-error">{{ pr.error | escape }}</p>
      {%- endif %}
      {%- if pr.files.size > 0 %}
      <ul class="spec-pr-files">
        {%- for file in pr.files %}
        <li><a href="{{ file.link | escape }}">{{ file.path | escape }}</a>{% if file.just_this %} (<a class="spec-pr-just-this" href="{{ file.just_this | escape }}" title="Its rendering with only this pull request's changes beside it">with just this pull request</a>){% endif %} <span class="spec-pr-added">+{{ file.added | escape }}</span> <span class="spec-pr-removed">−{{ file.removed | escape }}</span>{% if file.sections.size > 0 %} in {% for section in file.sections %}{% if section.link %}<a href="{{ section.link | escape }}">{{ section.title | escape }}</a>{% else %}{{ section.title | escape }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </section>
    {%- endfor %}
  </div>
  {%- else %}
  <p>It has no open pull requests.</p>
  {%- endif %}
  {%- else %}
  <p>Its pull requests haven't been synced yet.</p>
  {%- endif %}
  {%- else %}
  {%- if repos.size > 0 %}
  <table class="spec-prs-repos">
    <thead>
      <tr><th>Spec</th><th>Repository</th><th>Open</th><th>Approved</th><th>Changes requested</th><th title="Authored by people who can review the repository's pull requests (its owners, members and collaborators)">By people who can review</th><th>Drafts</th><th>Synced</th></tr>
    </thead>
    <tbody>
      {%- for repo in repos %}
      {%- capture page %}/{{ tree }}/spec-prs/{{ repo.spec | escape }}{% endcapture %}
      <tr><td><a class="spec-prs-repo-page" href="{{ page }}">{{ repo.spec | escape }}</a></td><td><a class="spec-prs-repo-github" href="{{ repo.url | escape }}">{{ repo.repo | escape }}</a></td><td>{{ repo.count | escape }}</td><td><a href="{{ page }}?facet-review=APPROVED">{{ repo.approved | escape }}</a></td><td><a href="{{ page }}?facet-review=CHANGES_REQUESTED">{{ repo.changes_requested | escape }}</a></td><td><a href="{{ page }}?facet-author=reviewer">{{ repo.by_reviewers | escape }}</a></td><td><a href="{{ page }}?facet-draft=draft">{{ repo.drafts | escape }}</a></td><td>{{ repo.synced | escape }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
  {%- else %}
  <p>No spec repository's pull requests have been synced yet.</p>
  {%- endif %}
  {%- endif %}
</div>
{%- if status.state == "queued" or status.state == "running" %}
<script src="/{{ tree }}/static/js/spec-prs-sync.js"></script>
{%- endif %}
{%- if imports.needed > 0 %}
<script src="/{{ tree }}/static/js/spec-prs-import.js"></script>
{%- endif %}
{%- if imports.pending > 0 %}
<script src="/{{ tree }}/static/js/spec-prs-imports.js"></script>
{%- endif %}
{%- endif %}
