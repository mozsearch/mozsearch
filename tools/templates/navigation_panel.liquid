<div class="panel" id="panel">
  <button id="panel-toggle">
    <span class="navpanel-toggle-icon icon-down-dir{% if expanded %} expanded{% endif %}" aria-hidden="false"></span>
    Navigation
    <span class="navpanel-other-icons">
      <a id="open-help" title="Open help page" href="https://firefox-source-docs.mozilla.org/contributing/searchfox.html" target="_blank"><span class="navpanel-icon icon-help-circled" aria-hidden="false"></span></a><a id="show-settings" title="Go to settings page" href="/{{ tree }}/pages/settings.html"><span class="navpanel-icon icon-cog expanded" aria-hidden="false"></span></a>
    </span>
  </button>
  <section id="panel-content" {%
           if expanded
           %}aria-expanded="true" aria-hidden="false"{%
           else
           %}aria-expanded="false" aria-hidden="true" style="display: none;"{%
           endif %}>
{%- comment %}(The page's lenses, if it has any: toggles showing more of its
contents, ex: "changes" for a query's results' history digests, which are
remembered and applied as soon as their buttons are there, so that the
contents don't change once loaded; see `EarlyLayout` in settings.js and
panel.js's `setupLensToggles`.){% endcomment -%}
{%- if panel_lenses %}
  <div class="lens-bar">
    <span class="lens-label">Lenses:</span>
    {%- for lens in panel_lenses %}
    <button type="button" class="lens-toggle" data-lens="{{ lens.key | escape }}" aria-pressed="false" title="{{ lens.title | escape }}">{{ lens.name | escape }}</button>
    {%- endfor %}
  </div>
  <script>typeof EarlyLayout != "undefined" && EarlyLayout.lenses();</script>
{%- endif %}
{%- comment %}(The facets filtering the page's list of files, if it has
one, ex: an explore page's or a query's results, and its choices of grouping
and sorting the files, if it has them; see facet_bar.liquid.){% endcomment -%}
{%- if panel_facets %}
  {% include 'facet_bar.liquid' facets: panel_facets, group_by: panel_group_by, sort_by: panel_sort_by %}
{%- endif %}
{%- comment %}(Sections rendered by the page's template, ex: a directory's
tests' CI results.){% endcomment -%}
{%- if extra_html %}
  {{ extra_html }}
{%- endif -%}
{%- if panel -%}
{%- for section in panel %}
  <h4>{{section.name | escape}}</h4>
  <ul>
{%- for item in section.items -%}
{% if item.link != "" -%}
{%- assign tag = "a" -%}
{%- else -%}
{%- assign tag = "button" -%}
{%- endif %}
    <li>
      <{{tag}} {%
               if item.id != ""
               %}id="{{item.id}}" {%
               endif
               %}{%
               if item.link != ""
               %}href="{{item.link | escape}}" {%
               endif
               %}{%
               if item.accel_key
               %}data-accel="{{item.accel_key | escape}}" {%
               endif
               %}title="{{item.tooltip | escape}}" class="icon item"{%
               if item.update_link_lineno != ""
               %} data-update-link="{{item.update_link_lineno | escape}}" data-link="{{item.link | escape}}}"{%
               endif
               %}>{%- if item.label.plaintext -%}{{ item.label.plaintext | escape }}{%- else -%}{{ item.label.html }}{%- endif -%}{%
        if item.accel_key
        %} <span class="accel">{{ item.accel_key | escape }}</span>{%
        endif
        %}{%
        if item.copyable
        %}<button class="copy" title="Copy to clipboard"><span class="icon-docs copy-icon"></span><span class="icon-ok tick-icon"></span></button>{%
        endif
        %}</{{tag}}>
    </li>
{% endfor -%}
  </ul>
{% endfor -%}
{%- endif %}
  </section>
</div>
<script>typeof EarlyLayout != "undefined" && EarlyLayout.panel();</script>
