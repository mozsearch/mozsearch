{%- comment -%}
  The facets of a list of files (see `format::explore_facets`), which
  facets.js uses to filter the files (`.facet-items [data-facets]`) to the
  selected values, and to group them by a facet: a collapsible box (with the
  navigation panel's arrow, since it's a control rather than content) with
  each facet's values (nested for hierarchical facets, ex: directories, with
  buttons showing all of them or only the biggest at the top; see
  facet_value.liquid), how many files each has, a button showing the elided
  ones, if any (see `FacetView::new`), and (if `group_by`) the choices of
  grouping and of sorting (if `sort_by`) after them.  And links beside a
  facet's label, if it has any (see `FacetView::actions`).  The items are files,
  unless `noun` and `nouns` say otherwise (ex: "pull request").
{%- endcomment -%}
<section class="facet-box"{% if noun %} data-noun="{{ noun }}" data-nouns="{{ nouns }}"{% endif %}>
  <div class="facet-header">
    <button type="button" class="facet-toggle" aria-expanded="true" aria-controls="facet-bar"><span class="facet-toggle-icon icon-down-dir expanded" aria-hidden="true"></span>Filtering</button>
    <span class="facet-status"></span>
    {%- comment %} (Invisible rather than hidden when nothing is filtered, so
    that the header's height doesn't change.) {% endcomment %}
    <button type="button" class="facet-clear facet-inactive">Show all {% if nouns %}{{ nouns }}{% else %}files{% endif %}</button>
  </div>
  <div class="facet-bar" id="facet-bar">
    <div class="facet-filters">
      {%- for facet in facets %}
      <div class="facet" data-facet="{{ facet.key }}">
        <span class="facet-label">{{ facet.label | escape }}:
        {%- if facet.nested %} <span class="facet-label-buttons"><button type="button" class="facet-expand-all" title="Show all of the values, nested and elided">+</button><button type="button" class="facet-collapse-all" title="Show only the biggest values at the top">−</button></span>{% endif -%}
        {%- if facet contains "actions" %}{% for action in facet.actions %} <a class="facet-action" href="{{ action.href | escape }}" title="{{ action.title | escape }}">{{ action.name | escape }}</a>{% endfor %}{% endif -%}
        </span>
        {%- for value in facet.values %}
        {%- include "facet_value.liquid" value: value %}
        {%- endfor %}
        {%- if facet.more > 0 %}<button type="button" class="facet-more" aria-expanded="false" data-more="{{ facet.more }}">{{ facet.more }} more</button>{% endif %}
      </div>
      {%- endfor %}
    </div>
    {%- if group_by %}
    <label class="facet-group-by">Group by <select>
      <option value="kind" selected>Path kind</option>
      <option value="subsystem">Subsystem</option>
      <option value="dir">Directory</option>
    </select></label>
    {%- if sort_by %}
    <label class="facet-sort-by">Sort by <select>
      <option value="alpha" selected>Alphabetical</option>
      <option value="size">Change size</option>
    </select></label>
    {%- endif %}
    {%- endif %}
  </div>
</section>
{%- comment %} (Deferred, since the files come after the bar.) {% endcomment %}
<script defer src="/{{ tree }}/static/js/facets.js"></script>
