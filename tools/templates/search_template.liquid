{% include 'header_search.liquid' title: "{{TITLE}} - mozsearch", autofocus: false, rev_box: false %}
<div id="scrolling">
  <div id="content" class="content" data-no-results="No results for current query.">
    {% include 'breadcrumbs.liquid' path: "", hidden: false, is_graph: false %}
    {% include 'navigation_panel.liquid' expanded: false, panel: null %}
    {%- comment %}(The router's results, escaped for a JSON data block; see
    search.js's SEARCH_RESULTS.){% endcomment %}
    <script type="application/json" data-global="SEARCH_RESULTS">{{ "{{BODY}}" }}</script>
  </div>
  {% include 'scroll_footer.liquid' %}
</div>
{% include 'footer.liquid' %}
