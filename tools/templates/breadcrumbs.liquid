{%- assign path_segments = path | split: "/" %}
  <div class="breadcrumbs{%- if hidden %} initially-hidden{% endif -%}">
    <a href="/{{tree}}/{% if rev %}rev/{{ rev | escape }}{% else %}source{% endif %}/">{{ tree }}</a><button id="tree-switcher" title="Open tree switcher menu" aria-expanded="false" aria-haspopup="true" aria-controls="tree-switcher-menu"></button><div id="tree-switcher-menu" title="Tree switcher" role="menu" class="context-menu initially-hidden"></div>
{%- for segment in path_segments -%}
  <span class="path-separator">/</span>
  {%- assign path_so_far = path_segments | slice: 0, forloop.index | join: "/" -%}
  <a href="/{{tree}}/{% if rev %}rev/{{ rev | escape }}{% else %}source{% endif %}/{{path_so_far | escape}}">{{ segment | escape }}</a>
{%- endfor -%}
{%- if is_graph %}
  <button id="diagram-panel-toggle" class="breadcrumbs-extra-button">
    Diagram Controls <span class="icon-cog"></span>
  </button>
{%- endif %}
  </div>
