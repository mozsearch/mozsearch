{%- capture title %}Q: {{ query | escape }}{% endcapture -%}
{% include 'header_query.liquid' title: title, autofocus: true %}
{%- assign is_graph = false -%}
{%- for result_pair in results -%}
  {%- if result_pair[0] == "GraphResultsBundle" -%}
    {%- assign is_graph = true -%}
  {%- endif %}
  {%- if result_pair[0] == "GraphInput" -%}
    {%- assign is_graph = true -%}
  {%- endif %}
{%- endfor -%}
<div id="scrolling">
  <div id="content" class="content" data-no-results="No results for current query.">
    {% include 'breadcrumbs.liquid' path: "", hidden: false, is_graph: is_graph %}
    {%- comment %}(Expanded with the facets of file-centric results, which
    filter them.){% endcomment %}
    {%- if file_facets %}
    {% include 'navigation_panel.liquid' expanded: true, panel: null, panel_facets: file_facets.facets, panel_group_by: false %}
    {%- else %}
    {% include 'navigation_panel.liquid' expanded: false, panel: null %}
    {%- endif %}
    {%- if search_rev != empty %}
    <div class="query-try-context">
      Searching try push <a href="/{{tree}}/try/{{ try_push | escape }}">{{ try_push | escape }}</a>
      as rebased onto <a href="/{{tree}}/commit/{{ try_base | escape }}">{{ try_base | slice: 0, 12 }}</a>,
      the indexed revision (<a href="/{{tree}}/query/{{preset}}?q={{ query | url_encode }}">search the indexed revision instead</a>).
    </div>
    {%- endif %}
    {%- if dwim %}
    <div class="query-interpretation query-dwim">
      <a href="{{ dwim.url | escape }}">Go to {{ dwim.url | escape }}</a> ({{ dwim.description | escape }})
    </div>
    {%- endif %}
    {%- if interpretation %}
    <div class="query-interpretation">
      Searching for <code>{{ query | escape }}</code>, the query for
      <code>{{ interpretation.input | escape }}</code>
      {%- if interpretation.changes != empty %} ({{ interpretation.changes | join: "; " | escape }}){% endif %}.
    </div>
    {%- endif %}
    <div class="query-result">
      {% for result_pair in results %}
        {% case result_pair[0] %}
        {% when "FlattenedResultsBundle" %}
          {% include 'query_results/rb_root.liquid' %}
        {% when "GraphResultsBundle" %}
          {% include 'query_results/graph_root.liquid' %}
        {% when "GraphInput" %}
          {% include 'query_results/graph_input.liquid' %}
        {% when "SymbolGraphCollection" %}
          {% include 'query_results/graph_collection_root.liquid' %}
        {% when "SymbolTreeTableList" %}
            {% include 'query_results/symbol_tree_table_list_root.liquid' %}
        {% when "TextFile" %}
          {% include 'query_results/text_file_root.liquid' %}
        {% else %}
          Unhandled results type {{result_pair[0]}}!
        {% endcase %}
      {% endfor %}
      {% if logs != empty -%}
      <fieldset id="query-debug-logs">
        <legend>Logs</legend>
        {%- for log in logs -%}
        <pre>
          {{- log | json | escape -}}
        </pre>
        {%- endfor -%}
      </fieldset>
      {%- endif %}
      <fieldset id="query-debug-results-json" aria-hidden="true">
        <legend>results JSON</legend>
        <pre id="query-debug-results-json-pre">
        </pre>
      </fieldset>
    </div>
  </div>
  <script>
var SYM_INFO = {{ SYM_INFO_STR }};
{%- comment %}
  (A copy of the results, rows included, which would double big pages, so
  only for debugging; otherwise the panel fetches the URL's JSON.)
{% endcomment %}
{%- if debug %}
var QUERY_RESULTS_JSON = {{ results | json }};
{%- endif %}
// Debug logs are always available for queries, so always set the variable to true;
// other pages will not have the variable defined and so the page will see undefined as false.
var IS_DEBUG_LOGS_AVAILABLE = true;
</script>
  {% include 'scroll_footer.liquid' search: "query" %}
</div>
{% include 'footer.liquid' %}
