{%- capture title %}Q: {{ query | escape }}{% endcapture -%}
{% include 'header_query.liquid' title: title, autofocus: true %}
{%- assign is_graph = false -%}
{%- for result_pair in results -%}
  {%- if result_pair[0] == "GraphResultsBundle" -%}
    {%- assign is_graph = true -%}
  {%- endif %}
  {%- if result_pair[0] == "GraphInput" -%}
    {%- assign is_graph = true -%}
  {%- endif %}
{%- endfor -%}
<div id="scrolling">
  <div id="content" class="content" data-no-results="No results for current query.">
    {% include 'breadcrumbs.liquid' path: "", hidden: false, is_graph: is_graph %}
    {%- comment %}(Expanded with the facets of file-centric results, which
    filter them.){% endcomment %}
    {%- if file_facets %}
    {% include 'navigation_panel.liquid' expanded: true, panel: null, panel_facets: file_facets.facets, panel_group_by: false, panel_sort_by: false, panel_lenses: file_facets.lenses, panel_lens_family: "results", panel_overview: file_facets.overview %}
    {%- comment %}(And with the facets of a client-side diagram's nodes, or
    the legend of a diagram's badges, which search.js's `Diagram` adds.){% endcomment %}
    {%- elsif graph_facets %}
    {% include 'navigation_panel.liquid' expanded: true, panel: null, panel_facets: graph_facets.facets, panel_group_by: false, panel_sort_by: false, panel_noun: "node", panel_nouns: "nodes" %}
    {%- comment %}(Or with the facets of a view's own items, ex: a crash
    report's threads; see `TextFile::facets`.){% endcomment %}
    {%- elsif view_facets %}
    {% include 'navigation_panel.liquid' expanded: true, panel: null, panel_facets: view_facets.facets, panel_group_by: false, panel_sort_by: false, panel_noun: view_facets.noun, panel_nouns: view_facets.nouns %}
    {%- comment %}(Or with the facets of a history grep's rows' files, but
    collapsed at first, as its rows are wide; see `history_grep_facets`.){% endcomment %}
    {%- elsif history_facets %}
    {% include 'navigation_panel.liquid' expanded: false, panel: null, panel_facets: history_facets.facets, panel_group_by: false, panel_sort_by: false %}
    {%- elsif graph_badges %}
    {% include 'navigation_panel.liquid' expanded: true, panel: null %}
    {%- else %}
    {% include 'navigation_panel.liquid' expanded: false, panel: null %}
    {%- endif %}
    {%- if search_rev != empty %}
    <div class="query-try-context">
      Searching try push <a href="/{{tree}}/{{ try_push_path | escape }}">{{ try_push | escape }}</a>
      as rebased onto <a href="/{{tree}}/commit/{{ try_base | escape }}">{{ try_base | slice: 0, 12 | escape }}</a>,
      the indexed revision (<a href="/{{tree}}/query/{{preset | escape}}?q={{ query | url_encode }}">search the indexed revision instead</a>).
    </div>
    {%- endif %}
    {%- if dwim %}
    <div class="query-interpretation query-dwim">
      <a href="{{ dwim.url | escape }}">Go to {{ dwim.url | escape }}</a> ({{ dwim.description | escape }})
    </div>
    {%- endif %}
    {%- if corrections != empty %}
    <div class="query-interpretation query-corrections">
      Nothing matched.  Did you mean {% for correction in corrections %}<a href="/{{ tree }}/query/{{ preset | escape }}?q={{ correction | url_encode }}{% if search_rev != empty %}&amp;rev={{ search_rev | url_encode }}{% endif %}"><code>{{ correction | escape }}</code></a>{% if forloop.last %}?{% elsif forloop.rindex == 2 %} or {% else %}, {% endif %}{% endfor %}
    </div>
    {%- endif %}
    {%- if interpretation %}
    <div class="query-interpretation">
      Searching for <code>{{ query | escape }}</code>, the query for
      <code>{{ interpretation.input | escape }}</code>
      {%- if interpretation.changes != empty %} ({{ interpretation.changes | join: "; " | escape }}){% endif %}.
    </div>
    {%- endif %}
    {%- if too_expensive %}
    <div class="query-too-expensive" role="alert">
      <p>{{ too_expensive.message | escape }}</p>
      {%- if too_expensive.details != empty %}
      <ul>
        {%- for detail in too_expensive.details %}
        <li>{{ detail | escape }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
      {%- if too_expensive.hints != empty %}
      <p>It would cost less:</p>
      <ul>
        {%- for hint in too_expensive.hints %}
        <li>{{ hint | escape }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
      {%- if too_expensive.signed_in_allows %}
      <p>Signed in, your limits would allow it.</p>
      {%- endif %}
    </div>
    {%- endif %}
    {%- comment %}(A query which failed says why, ex: a server it needed
    didn't answer, or a bug's comment which isn't there.){% endcomment %}
    {%- if problem %}
    <div class="query-problem" role="alert">
      <p>{{ problem.message | escape }}</p>
      {%- if problem.transient %}
      <p>It may work if you try again later.</p>
      {%- endif %}
    </div>
    {%- endif %}
    <div class="query-result">
      {% for result_pair in results %}
        {% case result_pair[0] %}
        {% when "FlattenedResultsBundle" %}
          {% include 'query_results/rb_root.liquid' %}
        {% when "GraphResultsBundle" %}
          {% include 'query_results/graph_root.liquid' %}
        {% when "GraphInput" %}
          {% include 'query_results/graph_input.liquid' %}
        {% when "SymbolGraphCollection" %}
          {% include 'query_results/graph_collection_root.liquid' %}
        {% when "SymbolTreeTableList" %}
            {% include 'query_results/symbol_tree_table_list_root.liquid' %}
        {% when "TextFile" %}
          {% include 'query_results/text_file_root.liquid' %}
        {% when "TokenHistory" %}
          {% include 'query_results/token_history_root.liquid' %}
        {% when "HistoryGrep" %}
          {% include 'query_results/history_grep_root.liquid' %}
        {% when "TokenNames" %}
          {% include 'query_results/token_names_root.liquid' %}
        {% else %}
          Unhandled results type {{result_pair[0] | escape}}!
        {% endcase %}
      {% endfor %}
      {% if logs != empty -%}
      <fieldset id="query-debug-logs">
        <legend>Logs</legend>
        {%- for log in logs -%}
        <pre>
          {{- log | json | escape -}}
        </pre>
        {%- endfor -%}
      </fieldset>
      {%- endif %}
      <fieldset id="query-debug-results-json" aria-hidden="true">
        <legend>results JSON</legend>
        <pre id="query-debug-results-json-pre">
        </pre>
      </fieldset>
    </div>
  </div>
  {%- comment %}(JSON data blocks, which static/js/page-data.js makes the
  globals: SYM_INFO beside the symbols' information a view's HTML added (ex: a
  crash view's excerpts'; see crash_stack.rs's `render_crash_stack`); a copy
  of the results, rows included, which would double big pages, so only for
  debugging (otherwise the panel fetches the URL's JSON); and
  IS_DEBUG_LOGS_AVAILABLE because debug logs are always available for
  queries, which other pages don't define, so they see it as false.){%
  endcomment %}
  <script type="application/json" data-global="SYM_INFO" data-merge>{{ SYM_INFO_STR }}</script>
  {%- if debug %}
  <script type="application/json" data-global="QUERY_RESULTS_JSON">{{ results | json_script }}</script>
  {%- endif %}
  <script type="application/json" data-global="IS_DEBUG_LOGS_AVAILABLE">true</script>
  {% include 'scroll_footer.liquid' search: "query" %}
</div>
{% include 'footer.liquid' %}
