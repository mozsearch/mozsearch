{%- comment %}A JS environment's tree (see config_defaults/panel_sections/tests_environments.liquid):
its global, its test's manifest, how it was started (a worker's or frame's),
its scripts in the order they're loaded into it (the file's own marked; each
with its role, and where a script loaded it: a loaded script's "loaded at",
not "loaded loaded at"), and
the environments it starts, each the same way; its links to its scripts keep
its test's path (`test_root`) as `?test=`, for their pages' panels.{% endcomment -%}
<span class="js-env-global">{{ env.global | escape }}</span>
{%- if env contains "variant" and env.variant != env.global %} <span class="js-env-variant">({{ env.variant | escape }})</span>{% endif -%}
{%- if env contains "started" %}, a {{ env.started.how | escape }} started at <a href="/{{ tree }}/source/{{ env.started.from[0] | escape }}#{{ env.started.from[1] | escape }}">{{ env.started.from[0] | split: "/" | last | escape }}:{{ env.started.from[1] | escape }}</a>{% endif -%}
{%- if env contains "manifest" %} <span class="js-env-manifest">(<a href="/{{ tree }}/source/{{ env.manifest | escape }}">{{ env.manifest | split: "/" | last | escape }}</a>
  {%- if env contains "ancestor" %}, included by <a href="/{{ tree }}/source/{{ env.ancestor | escape }}">{{ env.ancestor | split: "/" | last | escape }}</a>{% endif %})</span>
{%- endif %}
{%- if env.scripts == empty %} <span class="js-env-no-scripts">(no scripts)</span>
{%- else %}
<ol class="js-env-scripts">
{%- for script in env.scripts %}
  <li class="js-env-script js-env-role-{{ script.role | escape }}"{% if script.path == path %} aria-current="true"{% endif %}><a href="/{{ tree }}/source/{{ script.path | escape }}{% if test_root != script.path %}?test={{ test_root | escape }}{% endif %}">{{ script.path | escape }}</a> <span class="js-env-role">{{ script.role | escape }}</span>
  {%- if script contains "from" %} <span class="js-env-from">{% if script.role != "loaded" %}loaded {% endif %}at <a href="/{{ tree }}/source/{{ script.from[0] | escape }}#{{ script.from[1] | escape }}">{{ script.from[0] | split: "/" | last | escape }}:{{ script.from[1] | escape }}</a></span>{% endif -%}
  </li>
{%- endfor %}
</ol>
{%- endif %}
{%- if env contains "children" %}
<ul class="js-env-children">
{%- for child in env.children %}
  <li class="js-env-child">{% include 'js_environments/environment.liquid' env: child, tree: tree, path: path, test_root: test_root %}</li>
{%- endfor %}
</ul>
{%- endif %}
