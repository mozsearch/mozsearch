{%- comment %}A test's info box: one line saying whether the code may be less
tested than it looks (a warning) or untested (an error), with a few counts,
and a button to its details in the navigation panel (panel_sections/
tests.liquid).  The counts are its CI results' (tests.firefox.dev's), the
conditions applying to it in its manifests (metadata-analyze's
detailed.info.test_manifests, or else test-info-all-tests.json's), its failures,
and a WPT's meta file's.  (Liquid fails on missing keys, hence the contains
guards.){% endcomment -%}
{%- assign skip_conditions = 0 -%}
{%- assign run_conditions = 0 -%}
{%- assign fail_conditions = 0 -%}
{%- assign manifest_count = 0 -%}
{%- if detailed.info contains "test_manifests" -%}
  {%- for entry in detailed.info.test_manifests -%}
    {%- assign manifest_count = manifest_count | plus: 1 -%}
    {%- if entry.conditions contains "skip-if" -%}{%- assign skip_conditions = skip_conditions | plus: entry.conditions["skip-if"].size -%}{%- endif -%}
    {%- if entry.conditions contains "run-if" -%}{%- assign run_conditions = run_conditions | plus: entry.conditions["run-if"].size -%}{%- endif -%}
    {%- if entry.conditions contains "fail-if" -%}{%- assign fail_conditions = fail_conditions | plus: entry.conditions["fail-if"].size -%}{%- endif -%}
  {%- endfor -%}
{%- elsif concise.info contains "test" -%}
  {%- if concise.info.test contains "skip_if" and concise.info.test.skip_if != empty -%}{%- assign skip_conditions = 1 -%}{%- endif -%}
  {%- if concise.info.test contains "run_if" and concise.info.test.run_if != empty -%}{%- assign run_conditions = 1 -%}{%- endif -%}
  {%- if concise.info.test contains "fail_if" and concise.info.test.fail_if != empty -%}{%- assign fail_conditions = 1 -%}{%- endif -%}
  {%- comment %}(A WPT's is its directory, which isn't worth counting.){% endcomment -%}
  {%- unless concise.info contains "wpt" -%}
    {%- if concise.info.test contains "manifest" -%}{%- assign manifest_count = concise.info.test.manifest.size -%}{%- endif -%}
  {%- endunless -%}
{%- endif -%}
{%- assign failure_count = 0 -%}
{%- if concise.info contains "test" and concise.info.test contains "failure_count" -%}
  {%- assign failure_count = concise.info.test.failure_count -%}
{%- endif -%}
{%- assign wpt_disabling = 0 -%}
{%- assign wpt_subtests = 0 -%}
{%- if concise.info contains "wpt" -%}
  {%- if concise.info.wpt contains "disabling_conditions" -%}{%- assign wpt_disabling = concise.info.wpt.disabling_conditions.size -%}{%- endif -%}
  {%- if concise.info.wpt contains "disabled_subtests_count" -%}{%- assign wpt_subtests = concise.info.wpt.disabled_subtests_count -%}{%- endif -%}
{%- endif -%}
{%- if concise.info contains "test" or concise.info contains "test_results" or concise.info contains "wpt" or detailed.info contains "test_manifests" -%}
  {%- assign test_heading = "Test Info" -%}
  {%- assign test_severity = "info" -%}
  {%- if skip_conditions > 0 or run_conditions > 0 or fail_conditions > 0 or wpt_disabling > 0 or wpt_subtests > 0 -%}
    {%- assign test_heading = "Test Info: Warnings" -%}
    {%- assign test_severity = "warning" -%}
  {%- endif -%}
  {%- if failure_count > 0 -%}
    {%- assign test_heading = "Test Info: Errors" -%}
    {%- assign test_severity = "error" -%}
  {%- endif -%}
  {%- if concise.info contains "test_results" -%}
    {%- assign results = concise.info.test_results -%}
    {%- if results.issues > 0 -%}
      {%- if test_severity == "info" -%}
        {%- assign test_heading = "Test Info: Warnings" -%}
        {%- assign test_severity = "warning" -%}
      {%- endif -%}
      {%- if results.pass_rate < 90 -%}
        {%- assign test_heading = "Test Info: Errors" -%}
        {%- assign test_severity = "error" -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif %}
  <section class="info-box info-box-{{ test_severity }} info-box-concise">
    <h4>{{ test_heading }}</h4>
    <span class="info-box-facts">
  {%- if concise.info contains "test_results" -%}
      <span class="info-box-fact">{{ results.runs | thousands }} runs in {{ results.days }} days</span>
    {%- if results.issues > 0 -%}
      <span class="info-box-fact">{{ results.issues | thousands }} with failures, timeouts or crashes ({{ results.pass_rate }}% passed)</span>
    {%- endif -%}
    {%- if results.skips > 0 -%}
      <span class="info-box-fact">{{ results.skips | thousands }} skipped</span>
    {%- endif -%}
  {%- endif -%}
  {%- if skip_conditions > 0 -%}
      <span class="info-box-fact">skipped given {{ skip_conditions }} condition{% if skip_conditions != 1 %}s{% endif %}</span>
  {%- endif -%}
  {%- if run_conditions > 0 -%}
      <span class="info-box-fact">runs only given {{ run_conditions }} condition{% if run_conditions != 1 %}s{% endif %}</span>
  {%- endif -%}
  {%- if fail_conditions > 0 -%}
      <span class="info-box-fact">expected to fail given {{ fail_conditions }} condition{% if fail_conditions != 1 %}s{% endif %}</span>
  {%- endif -%}
  {%- if failure_count > 0 -%}
      <span class="info-box-fact">failed {{ failure_count }} times in 30 days</span>
  {%- endif -%}
  {%- if wpt_disabling > 0 -%}
      <span class="info-box-fact">disabled given {{ wpt_disabling }} condition{% if wpt_disabling != 1 %}s{% endif %}</span>
  {%- endif -%}
  {%- if wpt_subtests > 0 -%}
      <span class="info-box-fact">{{ wpt_subtests }} subtest issue{% if wpt_subtests != 1 %}s{% endif %} expected</span>
  {%- endif -%}
  {%- if manifest_count > 0 -%}
      <span class="info-box-fact">in {{ manifest_count }} manifest{% if manifest_count != 1 %}s{% endif %}</span>
  {%- endif %}
    </span>
    <button type="button" class="info-box-details" data-panel-section="panel-tests">Details</button>
  </section>
{%- endif -%}
