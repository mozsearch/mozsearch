{%- comment %}A test's details, in the navigation panel, which its info box
(info_boxes/test.liquid) summarizes: its CI results (tests.firefox.dev's), its
manifests and the conditions applying to it, with their lines
(metadata-analyze's detailed.info.test_manifests, or else
test-info-all-tests.json's concise.info.test), its failures, and for a WPT its
meta file and test ids.  (Liquid fails on missing keys, hence the contains
guards.){% endcomment -%}
{%- assign has_test = false -%}
{%- if concise.info contains "test" or concise.info contains "test_results" or concise.info contains "wpt" or detailed.info contains "test_manifests" -%}
  {%- assign has_test = true -%}
{%- endif -%}
{%- if has_test -%}
{%- capture double_newline %}

{% endcapture -%}
{%- capture newline %}
{% endcapture -%}
<h4 id="panel-tests">Tests</h4>
<div class="panel-tests">
  <ul>
{%- if concise.info contains "test_results" and detailed.info contains "test_results" %}
    <li>
  {%- include 'test_results/test_panel.liquid' results: concise.info.test_results, details: detailed.info.test_results, path: path %}
    </li>
{%- endif %}
{%- if detailed.info contains "test_manifests" %}
  {%- assign condition_keys = "skip-if|Skipped if any of:,run-if|Runs only if:,fail-if|Expected to fail if:" | split: "," -%}
  {%- for entry in detailed.info.test_manifests %}
    <li>Manifest: {% if entry contains "ancestor" %}<a href="/{{ tree }}/source/{{ entry.ancestor }}">{{ entry.ancestor }}</a> includes {% endif -%}
      <a href="/{{ tree }}/source/{{ entry.manifest }}#{{ entry.line }}" class="test-manifest-section">{{ entry.manifest }}</a>
    {%- if entry.conditions != empty %}
      <ul>
      {%- for key_label in condition_keys -%}
        {%- assign key_parts = key_label | split: "|" -%}
        {%- if entry.conditions contains key_parts[0] %}
        <li>{{ key_parts[1] }}
          <ul>
          {%- for condition in entry.conditions[key_parts[0]] %}
            <li><a href="/{{ tree }}/source/{{ condition.manifest }}#{{ condition.line }}" class="test-skip-info">{{ condition.text | escape }}</a>
            {%- case condition.from -%}
              {%- when "default" %} <span class="test-condition-from">(the manifest's default)</span>
              {%- when "include" %} <span class="test-condition-from">(where {{ condition.manifest }} includes it)</span>
              {%- when "ancestor-default" %} <span class="test-condition-from">({{ condition.manifest }}'s default)</span>
            {%- endcase -%}
            {%- if condition contains "comment" %} <span class="test-condition-comment">{{ condition.comment | linkify }}</span>{% endif -%}
            </li>
          {%- endfor %}
          </ul>
        </li>
        {%- endif -%}
      {%- endfor %}
      </ul>
    {%- endif %}
    </li>
  {%- endfor -%}
{%- elsif concise.info contains "test" -%}
  {%- if concise.info.test contains "skip_if" and concise.info.test.skip_if != empty %}
    <li>Skipped with pattern: <span class="test-skip-info">{{ concise.info.test.skip_if | replace: double_newline, newline | replace: newline, " OR " }}</span></li>
  {%- endif -%}
  {%- if concise.info.test contains "run_if" and concise.info.test.run_if != empty %}
    <li>Runs only with pattern: <span class="test-skip-info">{{ concise.info.test.run_if | replace: double_newline, newline | replace: newline, " OR " }}</span></li>
  {%- endif -%}
  {%- if concise.info.test contains "fail_if" and concise.info.test.fail_if != empty %}
    <li>Known to fail with pattern: <span class="test-skip-info">{{ concise.info.test.fail_if | replace: double_newline, newline | replace: newline, " OR " }}</span></li>
  {%- endif -%}
  {%- unless concise.info contains "wpt" -%}
    {%- if concise.info.test contains "manifest" and concise.info.test.manifest != empty %}
      {%- for aggr_manifest in concise.info.test.manifest -%}
        {%- assign manifests = aggr_manifest | split: ":" %}
    <li>Manifest: {% for manifest in manifests -%}
          {%- unless forloop.first %} includes {% endunless -%}<a href="/{{ tree }}/source/{{ manifest }}">{{ manifest }}</a>
        {%- endfor -%}</li>
      {%- endfor -%}
    {%- endif -%}
  {%- endunless -%}
{%- endif -%}
{%- if concise.info contains "test" and concise.info.test contains "failure_count" and concise.info.test.failure_count > 0 %}
    <li>Failed {{ concise.info.test.failure_count }} times in the preceding 30 days. <a href="https://bugzilla.mozilla.org/buglist.cgi?quicksearch={{ path }}">quicksearch this test</a></li>
{%- endif -%}
{%- if concise.info contains "wpt" -%}
  {%- capture wpt_meta_url -%}/{{ tree }}/source/{{ path | replace_first: "/tests/", "/meta/" }}.ini{%- endcapture -%}
  {%- if concise.info.wpt contains "disabling_conditions" %}
    <li>Its <a href="{{ wpt_meta_url }}">WPT meta file</a> disables it given conditions:
      <ul>{%- for cond_bug in concise.info.wpt.disabling_conditions %}
        <li><span class="test-skip-info">{{ cond_bug[0] | strip }}</span>&nbsp; : <a href="{{ cond_bug[1] | ensure_bug_url }}">{{ cond_bug[1] }}</a></li>
      {%- endfor -%}
      </ul>
    </li>
  {%- endif -%}
  {%- if concise.info.wpt contains "disabled_subtests_count" %}
    <li>Its <a href="{{ wpt_meta_url }}">WPT meta file</a> expects {{ concise.info.wpt.disabled_subtests_count }} subtest issues.</li>
  {%- endif -%}
  {%- if concise.info.wpt contains "test_ids" %}
    {%- if concise.bugzilla_component == empty -%}
      {%- assign bugzillaString = "" -%}
    {%- else -%}
      {%- assign bugzillaString = concise.bugzilla_component | join: "::" -%}
    {%- endif %}
    <li>It may be referenced by the following <a href="https://firefox-source-docs.mozilla.org/web-platform/index.html#running-tests">Test IDs</a>:
      <ul>{%- for test_id in concise.info.wpt.test_ids %}
        <li>/{{ test_id }} - <a href="https://wpt.fyi/results/{{ test_id }}">WPT Dashboard</a> <a href="https://jgraham.github.io/wptdash/?bugComponent={{ bugzillaString | downcase }}#/{{ test_id }}">Interop Dashboard</a></li>
      {%- endfor -%}
      </ul>
    </li>
  {%- endif -%}
{%- endif %}
  </ul>
</div>
{%- endif -%}
