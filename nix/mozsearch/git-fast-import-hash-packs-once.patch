Subject: fast-import: hash each pack once

git fast-import hashed each pack it wrote three times: as it wrote it (with
hashwrite), and when it ended the pack, to put the object count in its
header, fixup_pack_header_footer() rehashed the whole pack while also
hashing it again as it was before, to check that against the first hash.
For mozsearch's history repos, which git fast-import writes ~250 MB of
blobs a second to, rehashing the packs was 35% of its time (in gdb samples)
and hashing blobs, including as they were written, another 25%.

Don't hash the pack as it's written, and so don't check what's read back.

---
--- a/builtin/fast-import.c
+++ b/builtin/fast-import.c
@@ -778,6 +778,11 @@
 	p->do_not_close = 1;
 	p->repo = the_repository;
 	pack_file = hashfd(the_repository->hash_algo, pack_fd, p->pack_name);
+	/*
+	 * end_packfile() hashes the whole pack once it knows the object
+	 * count, so don't hash it as it's written too.
+	 */
+	pack_file->skip_hash = 1;
 
 	pack_data = p;
 	pack_size = write_pack_header(pack_file, 0);
@@ -879,18 +884,20 @@
 	if (object_count) {
 		struct odb_source_files *files = odb_source_files_downcast(pack_data->repo->objects->sources);
 		struct packed_git *new_p;
-		struct object_id cur_pack_oid;
 		char *idx_name;
 		int i;
 		struct branch *b;
 		struct tag *t;
 
 		close_pack_windows(pack_data);
-		finalize_hashfile(pack_file, cur_pack_oid.hash, FSYNC_COMPONENT_PACK, 0);
+		finalize_hashfile(pack_file, NULL, FSYNC_COMPONENT_PACK, 0);
+		/*
+		 * (Not checking what it reads back against the hash of what was
+		 * written, which start_packfile() skips.)
+		 */
 		fixup_pack_header_footer(the_hash_algo, pack_data->pack_fd,
 					 pack_data->hash, pack_data->pack_name,
-					 object_count, cur_pack_oid.hash,
-					 pack_size);
+					 object_count, NULL, 0);
 
 		if (object_count <= unpack_limit) {
 			if (!loosen_small_pack(pack_data)) {
