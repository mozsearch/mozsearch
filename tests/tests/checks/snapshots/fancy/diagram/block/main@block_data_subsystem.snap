---
source: src/bin/test-index.rs
expression: "&fb.contents"
input_file: inputs/fancy/diagram/block/block_data_subsystem
---
digraph g {
  graph[fontname="Courier New" fontsize=12 compound=true]
  node[shape=box fontname="Courier New" fontsize=10]
  subgraph "SYN_1" {
    cluster=true
    label="Core"
    "SYN_0"[shape=point style=invis]
    subgraph "SYN_3" {
      cluster=true
      label="Rollup Model"
      "SYN_2"[shape=point style=invis]
      "T_rollup::Store"[id=Gidn1 label=<Store> class="diagram-depth-1"]
    }
    subgraph "SYN_5" {
      cluster=true
      label="Rollup View"
      "SYN_4"[shape=point style=invis]
      "T_rollup::Controller"[id=Gidn0 label=<Controller> class="diagram-depth-1"]
      "T_rollup::Panel"[id=Gidn2 label=<Panel> class="diagram-depth-1"]
      subgraph  {
        rank=same
        cluster=false
        label=""
        "T_rollup::Controller"
        "T_rollup::Panel"
      }
    }
  }
  "T_rollup::Controller" -> "T_rollup::Store" [style=solid arrowhead=normal id=Gide0 label="2" penwidth="5.0" tooltip="2 flows, ex: rollup::Controller::mInput → rollup::Stats::mLast"]
  "T_rollup::Panel" -> "T_rollup::Store" [style=solid arrowhead=normal id=Gide1 label="2" penwidth="5.0" tooltip="2 flows, ex: rollup::Panel::Edit → rollup::Stats::mLast"]
  "T_rollup::Store" -> "T_rollup::Panel" [style=solid arrowhead=normal id=Gide2 label="1" penwidth="1.0" tooltip="1 flows, ex: rollup::Store::mValue → rollup::Panel::mShown"]
}
