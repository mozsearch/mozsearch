#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# The same repository as the "searchfox" tree, but with the classic line blame
# rather than the token-centric history (a tree has one or the other), so that
# the webtests cover both kinds of blame.

echo "Performing setup::ensure-no-diff step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

pushd $GIT_ROOT
if ! git diff --exit-code; then
    set +x
    echo ""
    echo "!!! CRITICAL !!!: Uncommitted changes found. Please commit them before building."
    echo ""
    git status
    exit 1
fi
popd

echo "Performing setup::build-blame step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

# build-blame only processes revisions it hasn't already (see
# `tools::source_mapping`), so the blame is kept between builds when
# CLEAN_HISTORY is auto (the Makefile's check-all's) and what it's derived with
# didn't change since it was built (its key; see scripts/history-inputs-key.sh),
# else built again from scratch, as always before.
BLAME_KEY=$("$MOZSEARCH_PATH/scripts/history-inputs-key.sh" "$MOZSEARCH_PATH" "tests/$TREE_NAME")
if [ "${CLEAN_HISTORY:-}" = "auto" ] && [ -d "$BLAME_ROOT" ] &&
    [ "$(cat "$BLAME_ROOT/../blame-inputs-key" 2>/dev/null)" = "$BLAME_KEY" ]; then
    echo "Keeping the blame: what it's derived with is the same."
else
    rm -rf $BLAME_ROOT
    mkdir -p $BLAME_ROOT
    git init $BLAME_ROOT
fi
rm -f "$BLAME_ROOT/../blame-inputs-key"
build-blame $GIT_ROOT $BLAME_ROOT
echo "$BLAME_KEY" > "$BLAME_ROOT/../blame-inputs-key"
