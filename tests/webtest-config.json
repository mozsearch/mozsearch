{
  "mozsearch_path": "$MOZSEARCH_PATH",
  "config_repo": "$CONFIG_REPO",

  "default_tree": "tests",

  "crash_reports_url": "file://$MOZSEARCH_PATH/tests/crash-reports/{}.json",
  "bugzilla_url": "file://$MOZSEARCH_PATH/tests/bugzilla",
  "code_review_url": "file://$MOZSEARCH_PATH/tests/code-review",
  "crash_sets_path": "$WORKING/crash-sets",
  "crash_sets_seed": "$MOZSEARCH_PATH/tests/crash-sets",
  "crash_stats_api": "file://$MOZSEARCH_PATH/tests/crash-stats",

  "trees": {
    "tests": {
      "IMPORT": {
        "file": "$MOZSEARCH_PATH/tests/config.json",
        "tree_name": "tests"
      }
    },
    "searchfox": {
      "IMPORT": {
        "file": "$MOZSEARCH_PATH/tests/searchfox-config.json",
        "tree_name": "searchfox"
      },
      "linked_trees": { "SPEC_": "tests" }
    },
    "searchfox-line-blame": {
      "IMPORT": {
        "file": "$MOZSEARCH_PATH/tests/searchfox-config.json",
        "tree_name": "searchfox"
      },
      "priority": 90,
      "index_path": "$WORKING/searchfox-line-blame",
      "objdir_path": "$WORKING/searchfox-line-blame/objdir",
      "git_blame_path": "$WORKING/searchfox-line-blame/blame",
      "history_path": null,
      "codesearch_path": "$WORKING/searchfox-line-blame/livegrep.idx",
      "codesearch_port": 8082,
      "scip_subtrees": {},
      "data_api": false
    },
    "spechist": {
      "priority": 80,
      "on_error": "halt",
      "cache": "everything",
      "index_path": "$WORKING/spechist",
      "files_path": "$WORKING/spechist/git",
      "objdir_path": "$WORKING/spechist/objdir",
      "git_path": "$WORKING/spechist/git",
      "history_path": "$WORKING/spechist/history",
      "codesearch_path": "$WORKING/spechist/livegrep.idx",
      "codesearch_port": 8084
    },
    "trydelta": {
      "priority": 70,
      "on_error": "halt",
      "cache": "everything",
      "index_path": "$WORKING/trydelta",
      "files_path": "$WORKING/trydelta/git",
      "objdir_path": "$WORKING/trydelta/objdir",
      "git_path": "$WORKING/trydelta/git",
      "history_path": "$WORKING/trydelta/history",
      "codesearch_path": "$WORKING/trydelta/livegrep.idx",
      "codesearch_port": 8085,
      "search_endpoint": "query",
      "wpt_root": "testing/web-platform",
      "js_environments": "trydelta/js-environments.toml",
      "js_environments_analysis": true,
      "scip_subtrees": {
        "typescript": {
          "scip_index_path": "$WORKING/trydelta/typescript.scip",
          "subtree_root": ""
        }
      },
      "linked_trees": {
        "SPEC_": "tests"
      },
      "private": {
        "note": "The data API's config route doesn't expose this."
      }
    },
    "trydelta-shared": {
      "priority": 65,
      "on_error": "halt",
      "cache": "everything",
      "index_path": "$WORKING/trydelta-shared",
      "files_path": "$WORKING/trydelta/git",
      "objdir_path": "$WORKING/trydelta-shared/objdir",
      "git_path": "$WORKING/trydelta/git",
      "history_path": "$WORKING/trydelta/history",
      "codesearch_path": "$WORKING/trydelta-shared/livegrep.idx",
      "codesearch_port": 8087,
      "search_endpoint": "query",
      "wpt_root": "testing/web-platform",
      "js_environments": "trydelta/js-environments.toml",
      "js_environments_analysis": true,
      "scip_subtrees": {
        "typescript": {
          "scip_index_path": "$WORKING/trydelta-shared/typescript.scip",
          "subtree_root": ""
        }
      },
      "linked_trees": {
        "SPEC_": "tests"
      },
      "web_analysis_from": "trydelta"
    },
    "specpr": {
      "priority": 60,
      "on_error": "halt",
      "cache": "everything",
      "index_path": "$WORKING/specpr",
      "files_path": "$WORKING/specpr/git",
      "objdir_path": "$WORKING/specpr/objdir",
      "git_path": "$WORKING/specpr/git",
      "history_path": "$WORKING/specpr/history",
      "codesearch_path": "$WORKING/specpr/livegrep.idx",
      "codesearch_port": 8086
    }
  },

  "pipeline_trees": true,
  "setup_groups": [["tests"], ["searchfox", "searchfox-line-blame"], ["spechist"], ["trydelta", "trydelta-shared"], ["specpr"]],
  "allow_webtest": true
}
