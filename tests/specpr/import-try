#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# The specpr tree's try imports (see tools/src/try_import.rs): a spec's pull
# request, SPEC/NUMBER, fetched from the spec's repository and made into
# forest commits (see build-spec-pr), and then imported like any tree's push.
# (As a tree of specs' hook would, but with the specs as setup wrote them,
# with where it made their repositories.)

NAME=$1
SPECS_TOML="$(dirname "$GIT_ROOT")/upstream/specs.toml"
OUT=$(mktemp)
if ! build-spec-pr --fetch "$SPECS_TOML" "$GIT_ROOT" "$NAME" > "$OUT"; then
    cat "$OUT"
    exit 1
fi
cat "$OUT"
STACK=$(sed -n 's/^stack: //p' "$OUT")
HEAD_REV=$(sed -n 's/^head: //p' "$OUT")
BASE=$(sed -n 's/^base: //p' "$OUT")
rm -f "$OUT"

PUSH_REVS="$STACK" "$MOZSEARCH_PATH/scripts/import-try-push.sh" \
    "$GIT_ROOT" "$HISTORY_ROOT" "$GIT_BRANCH" "$NAME" "$HEAD_REV" "$MAX_REVISIONS"

# Its head's renderings of the Bikeshed specs it changes (which the web server
# can't render; see render-spec-pr).  A tree of specs' hook runs this in a
# sandbox (see ../../config's wubspecs/import-try); the container has no
# bubblewrap.
RENDERED="$INDEX_ROOT/try-rendered/$HEAD_REV"
mkdir -p "$RENDERED"
render-spec-pr "$SPECS_TOML" "$GIT_ROOT" "${NAME%%/*}" "$BASE" "$HEAD_REV" "$RENDERED" ||
    echo "Rendering its Bikeshed specs failed."
