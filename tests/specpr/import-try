#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# The specpr tree's try imports (see tools/src/try_import.rs): a spec's pull
# request, SPEC/NUMBER, fetched from the spec's repository and made into
# forest commits (see build-spec-pr), and then imported like any tree's push.
# (As a tree of specs' hook would, but with the specs as setup wrote them,
# with where it made their repositories.)

NAME=$1
SPECS_TOML="$(dirname "$GIT_ROOT")/upstream/specs.toml"
OUT=$(mktemp)
step() {
    echo "Performing import::$1 step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
}
# (Fetched from GitHub first, beside the other imports, which don't wait for
# it; see mozsearch's tools/src/spec_forest.rs's `fetch_pull_request`.)
step fetch
if ! build-spec-pr --fetch-only "$SPECS_TOML" "$GIT_ROOT" "$NAME" > "$OUT"; then
    cat "$OUT"
    exit 1
fi
cat "$OUT"
# (Its forest commits take turns with the other imports' forest commits, by
# a lock of their own rather than the history's, TRY_IMPORT_LOCK (see
# mozsearch's tools/src/try_import.rs), so that while a batch of imports
# processes its history the others make theirs and wait for the next batch:
# they only write new objects and the pull request's own refs, which the
# history steps don't, and read refs which only the forest's update at
# indexing changes; see mozsearch's tools/src/spec_forest.rs's
# `pull_request_commits`.  The steps say when it got the lock.)
step wait-for-forest
exec 9>"$HISTORY_ROOT/try-imports/forest.lock"
flock 9
step forest-commits
if ! build-spec-pr "$SPECS_TOML" "$GIT_ROOT" "$NAME" > "$OUT"; then
    cat "$OUT"
    exit 1
fi
flock -u 9
exec 9>&-
cat "$OUT"
STACK=$(sed -n 's/^stack: //p' "$OUT")
HEAD_REV=$(sed -n 's/^head: //p' "$OUT")

# Its history, with the other imports waiting to import theirs, in one
# history run (see mozsearch's scripts/import-try-push-batched.sh, which
# takes the history's lock).
# (The tests' imports wait a few seconds for each other, so that those asked
# for together, ex: test_SpecPullRequestImports', are imported together.)
step history
HISTORY_BATCH_WAIT=3 PUSH_REVS="$STACK" "$MOZSEARCH_PATH/scripts/import-try-push-batched.sh" \
    "$GIT_ROOT" "$HISTORY_ROOT" "$GIT_BRANCH" "$NAME" "$HEAD_REV" "$MAX_REVISIONS"
step unlocked

# Its renderings and semantic analysis (without bubblewrap, which the
# container doesn't have; a tree of specs' hook sandboxes them, see
# ../../config's wubspecs/import-try).  (If that fails, it's still imported.)
SANDBOX=none "$MOZSEARCH_PATH/scripts/analyze-spec-pr.sh" "$SPECS_TOML" "$NAME" "$OUT" ||
    echo "WARNING: Its semantic analysis failed."
rm -f "$OUT"
