#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# I think we used to try and delete the whole dir but we were messing it up.
#rm -rf $INDEX_ROOT

echo "Performing setup::ensure-no-diff step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

pushd $GIT_ROOT
if ! git diff --exit-code; then
    set +x
    echo ""
    echo "!!! CRITICAL !!!: Uncommitted changes found. Please commit them before building."
    echo ""
    git status
    exit 1
fi
popd

echo "Performing setup::build-blame step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

rm -rf $BLAME_ROOT
mkdir -p $BLAME_ROOT
git init $BLAME_ROOT
build-blame $GIT_ROOT $BLAME_ROOT

echo "Performing setup::codecov2git step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

rm -rf "$COVERAGE_ROOT"
mkdir -p "$COVERAGE_ROOT"
HEAD_OID="$(git -C "$GIT_ROOT" rev-parse HEAD)"
HEAD_DATE="$(git -C "$GIT_ROOT" show --no-patch --format=%cI HEAD)"
codecov2git --report "$GIT_ROOT/tests/searchfox/metadata/code-coverage-report.json" --output-repo "$COVERAGE_ROOT" --commit "$HEAD_OID" --date "$HEAD_DATE"

echo "Performing setup::build-syntax-token-tree step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

# The history tools only process revisions they haven't already (see
# `tools::source_mapping`), so we keep the history between builds, even across
# rebases.  After changing how the history is derived, set CLEAN_HISTORY=1 (ex:
# `make clean-build-searchfox-repo`) to regenerate it from scratch.
if [ -n "${CLEAN_HISTORY:-}" ]; then
  rm -rf "$HISTORY_ROOT"
fi

mkdir -p $HISTORY_ROOT
if [ ! -d $HISTORY_ROOT/syntax ]; then
  mkdir -p $HISTORY_ROOT/syntax
  git init $HISTORY_ROOT/syntax
fi
if [ ! -d $HISTORY_ROOT/timeline ]; then
  mkdir -p $HISTORY_ROOT/timeline
  git init $HISTORY_ROOT/timeline
fi
mkdir -p $HISTORY_ROOT/rev-summaries
HISTORY_CONFIG=$CONFIG_REPO/$TREE_NAME/history
if [ -d "$HISTORY_CONFIG" ]; then
  build-syntax-token-tree $GIT_ROOT $HISTORY_ROOT/syntax $HISTORY_CONFIG
else
  build-syntax-token-tree $GIT_ROOT $HISTORY_ROOT/syntax
fi
build-timeline-tree $GIT_ROOT $HISTORY_ROOT/syntax $HISTORY_ROOT/timeline $HISTORY_ROOT/rev-summaries

echo "Performing setup::build-commit-index step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

build-commit-index $GIT_ROOT $HISTORY_ROOT/commit-index

