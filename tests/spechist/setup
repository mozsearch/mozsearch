#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# A tree of a spec whose history renames and removes definitions which the
# tree's other file cites, for the stale-anchor suggestions (see
# tools/src/spec_analyze/stale.rs): its git repo has a commit per revision in
# revs/ (each the files it changes), with forged authors and dates for stable
# commit SHAs, and its history is the token-centric history.

echo "Performing setup::git-repository step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

MESSAGES=(
    "Add the History spec, and code citing it"
    "Rename widget frobnication to widget frobbing"
    "Remove the gadget hum"
    "Let widgets wobble"
    "Add notes whose tokens overlap"
    "Add the jiggling and wiggling specs"
)
rm -rf "$GIT_ROOT"
mkdir -p "$GIT_ROOT"
pushd "$GIT_ROOT"
export GIT_AUTHOR_NAME="Searchfox"
export GIT_AUTHOR_EMAIL="searchfox@localhost"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
git init -b main
for REV in 1 2 3 4 5 6; do
    cp -r "$CONFIG_REPO/$TREE_NAME/revs/$REV/." .
    git add -A
    export GIT_AUTHOR_DATE="2025-02-0${REV}T12:00+0100"
    export GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE"
    git commit -m "${MESSAGES[$((REV - 1))]}"
done
popd

echo "Performing setup::build-history step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

# (From scratch, since it's quick.)
rm -rf "$HISTORY_ROOT"
mkdir -p $HISTORY_ROOT/rev-summaries
for repo in syntax timeline; do
    mkdir -p $HISTORY_ROOT/$repo
    git init $HISTORY_ROOT/$repo
done
$MOZSEARCH_PATH/scripts/build-history.py $GIT_ROOT $HISTORY_ROOT

# The token journals' records sum to their tokens' instances (see
# check-token-counts), which token-timeline:'s counts need.
check-token-counts $HISTORY_ROOT --show 20

echo "Performing setup::build-commit-index step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
build-commit-index $GIT_ROOT $HISTORY_ROOT/commit-index

echo "Performing setup::stale-anchors step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

# The anchors cite.cpp cites which the spec no longer defines (as the tree's
# indexing writes them in stale-anchors-cited.json, whose last version a
# config repo would download here, but without an indexing yet), looked up in
# the history.
stale-anchors $CONFIG_REPO/$TREE_NAME/specs.toml $GIT_ROOT $HISTORY_ROOT \
    $CONFIG_REPO/$TREE_NAME/stale-anchors-cited.json
