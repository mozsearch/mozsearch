#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# The tree's C++, compiled with the indexer for one platform, and its Rust,
# rust-analyzer's index of it (merged, like trees with several platforms'
# analyses; see tests/tests/build-c.sh).

echo "Performing build::build-c step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

mkdir -p $OBJDIR
$MOZSEARCH_PATH/scripts/indexer-setup.py > $INDEX_ROOT/config
source $INDEX_ROOT/config

cd $FILES_ROOT
for SRC_FILE in $(git ls-files '*.cpp'); do
    mkdir -p $(dirname $OBJDIR/$SRC_FILE)
    MOZSEARCH_PLATFORM=linux64 $CXX $SRC_FILE -std=c++17 -I . -c -o $OBJDIR/${SRC_FILE%.cpp}.o -Wall
done
mv $INDEX_ROOT/analysis $INDEX_ROOT/analysis-linux64

echo "Performing build::rust-analyzer step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
# (Its configuration, build scripts' outputs and index outside of the objdir,
# whose text files are the tree's generated files.  Its try pushes' analysis
# is of the files they can change; see analyze-try.)
cat > $INDEX_ROOT/rust-analyzer.json <<EOF
{
  "rust-analyzer.server.extraEnv": {
    "CARGO_TARGET_DIR": "$INDEX_ROOT/rust-target"
  }
}
EOF
rust-analyzer scip . --output $INDEX_ROOT/rust.scip --config-path $INDEX_ROOT/rust-analyzer.json
scip-indexer $CONFIG_FILE $TREE_NAME --subtree-root "." --analysis-root $INDEX_ROOT/analysis-linux64 \
    $INDEX_ROOT/rust.scip

mkdir -p $INDEX_ROOT/analysis
# (merge-analyses takes the platform from the analysis-PLATFORM directory.)
pushd $INDEX_ROOT
(cd analysis-linux64 && find . -type f | sed 's#^\./##') | while read -r FILE; do
    mkdir -p $(dirname analysis/$FILE)
    merge-analyses analysis-linux64/$FILE > analysis/$FILE
done
popd
rm -rf $INDEX_ROOT/analysis-linux64

# And its JS, with scip-typescript, for its typescript scip subtree (whose
# try pushes' analysis is of only the files they change, with the projects
# at their heads, listed as these are; see analyze-try).
echo "Performing build::scip-typescript step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
(cd $FILES_ROOT && find . -name '[tj]sconfig.json' | LC_ALL=C sort) > $INDEX_ROOT/typescript-projects
$MOZSEARCH_PATH/scripts/scip-typescript-index.sh $FILES_ROOT $INDEX_ROOT/typescript-projects \
    $INDEX_ROOT/typescript.scip
