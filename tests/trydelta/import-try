#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# The trydelta tree's try imports (see tools/src/try_import.rs), with semantic
# analysis (see tools/src/try_delta.rs): like spechist's, a push is one of
# try/'s (a git push's, git/REV, try/git/REV's, whose commits aren't REV, as
# an hg push's aren't its revision), try/NAME/N being the files its Nth commit changes and
# try/NAME/N.message its message, committed on top of the tree's head, or of
# the revision try/NAME/base names, if any (ex: HEAD~1, for a push based on an
# older revision), with forged authors and dates, for stable SHAs, and
# imported like any tree's push.  The first try/NAME/public of its commits
# (if it says) aren't its stack's but the trunk's it's on (ex: a push on a
# newer trunk revision than the indexed one), as the try repository's public
# changesets are; and with try/NAME/unknown-stack, none of them are known to
# be its stack's, as when the try repository's draft changesets and pushlog
# can't be read.  As the config repos' hooks do, its stack is rebased onto
# the indexed revision first (see rebase-try-push.sh), whose steps' lines are
# "semantic::" steps' and the import's "try-import::" steps' (for its page to
# say why it has no semantic analysis; see try_import's `semantic_failure`),
# unless it's unknown (its revisions since the indexed one could be the
# trunk's too).  If it rebases, it's analyzed semantically (see analyze-try),
# and the history imports the push as it is and its rebased stack too (see
# import-try-rebased.sh), or, if it's on a newer trunk revision than the
# indexed one, only its rebased stack, as the push (not the trunk's revisions
# since the indexed one).  If not, the history imports the push as it is
# (with those revisions), and it has no semantic analysis, rather than one of
# those revisions' changes too.

NAME=$1
# (In phases, as the server asks (TRY_IMPORT_PHASE; see
# tools/src/try_import.rs's `Phase`): with "history", up to the push's
# history's import, leaving its semantic analysis's state, and how many
# translation units it compiles (its changed C and C++ files), in
# SEMANTIC_STATE, for its semantic phase, "semantic", which runs only
# semantic_phase; without it, both.)
PHASE=${TRY_IMPORT_PHASE:-}
SEMANTIC_STATE=$HISTORY_ROOT/try-imports/$NAME.semantic
semantic_phase() {
    echo "Performing try-import::semantic step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
    # (A push whose try/NAME/slow-semantic says so waits that many seconds
    # first, for a test to see it analyzing; see test_TrySemanticPhase.js.)
    # (And says so, as progress, for its import's status; see
    # tools/src/try_import.rs's `StepFollower`.)
    if [ -f "$CONFIG_REPO/$TREE_NAME/try/$NAME/slow-semantic" ]; then
        echo "Progress: waiting $(cat "$CONFIG_REPO/$TREE_NAME/try/$NAME/slow-semantic") s, as its slow-semantic says"
        sleep "$(cat "$CONFIG_REPO/$TREE_NAME/try/$NAME/slow-semantic")"
    fi
    if "$CONFIG_REPO/$TREE_NAME/analyze-try" "$NAME" "$REBASED"; then
        if [ -n "$ALSO_REBASED" ]; then
            echo "Performing try-import::rebased step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
            "$MOZSEARCH_PATH/scripts/import-try-rebased.sh" \
                "$GIT_ROOT" "$HISTORY_ROOT" "$GIT_BRANCH" "$NAME" "$MAX_REVISIONS" ||
                echo "WARNING: The push's rebased stack's import failed."
        fi
    else
        echo "WARNING: The push's semantic analysis failed."
    fi
}
if [ "$PHASE" = semantic ]; then
    if [ ! -f "$SEMANTIC_STATE" ]; then
        echo "ERROR: $NAME has no semantic analysis waiting."
        exit 1
    fi
    . "$SEMANTIC_STATE"
    semantic_phase
    rm -f "$SEMANTIC_STATE"
    exit 0
fi
# (Or a pull request of the tree's GitHub repository, `github/NUMBER`, as the
# config says it imports them (`github_pull_requests`), whose commits are
# pulls/NUMBER's, as a push's are; see tests/github-api, its fixtures of
# GitHub's API.)
case "$NAME" in
    github/*) PUSH="$CONFIG_REPO/$TREE_NAME/pulls/${NAME#github/}" ;;
    *) PUSH="$CONFIG_REPO/$TREE_NAME/try/$NAME" ;;
esac
if [ ! -d "$PUSH" ]; then
    echo "ERROR: there's no try push $NAME."
    exit 1
fi

export GIT_DIR="$GIT_ROOT/.git"
export GIT_AUTHOR_NAME="Searchfox"
export GIT_AUTHOR_EMAIL="searchfox@localhost"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
# (Without touching the tree's checkout.)
export GIT_INDEX_FILE=$(mktemp)
HEAD_REV=$(git rev-parse "$(cat "$PUSH/base" 2>/dev/null || echo HEAD)")
git read-tree "$HEAD_REV"
REVS=()
N=1
while [ -f "$PUSH/$N.message" ]; do
    if [ -d "$PUSH/$N" ]; then
        (cd "$PUSH/$N" && find . -type f | sed 's#^\./##') | while read -r FILE; do
            git update-index --add --cacheinfo 100644 "$(git hash-object -w "$PUSH/$N/$FILE")" "$FILE"
        done
    fi
    export GIT_AUTHOR_DATE="2025-05-0${N}T12:00+0100"
    export GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE"
    HEAD_REV=$(git commit-tree "$(git write-tree)" -p "$HEAD_REV" -F "$PUSH/$N.message")
    REVS+=("$HEAD_REV")
    N=$((N + 1))
done
rm -f "$GIT_INDEX_FILE"
unset GIT_DIR GIT_INDEX_FILE
PUBLIC=$(cat "$PUSH/public" 2>/dev/null || echo 0)
STACK="${REVS[*]:$PUBLIC}"
if [ -f "$PUSH/unknown-stack" ]; then
    STACK=""
fi

echo "Performing semantic::rebase step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
IMPORT_REV=$HEAD_REV
IMPORT_REVS=$STACK
ALSO_REBASED=""
REBASED=""
if [ -z "${STACK// /}" ]; then
    echo "ERROR: Its stack (which of its commits are its own, rather than the trunk's it's on) is unknown, so it has no semantic analysis (which could be of the trunk's changes since the indexed revision too)."
elif REBASED=$(PUSH_REVS="$STACK" "$MOZSEARCH_PATH/scripts/rebase-try-push.sh" "$GIT_ROOT" "$NAME" "$HEAD_REV"); then
    # (The revisions the push has which the indexed revision doesn't: more
    # than its stack's, if it's on a newer trunk revision.)
    if (( $(git -C "$GIT_ROOT" rev-list --count "$HEAD_REV" --not HEAD) > $(wc -w <<< "$STACK") )); then
        IMPORT_REV=$REBASED
        IMPORT_REVS=$(git -C "$GIT_ROOT" rev-list --reverse "HEAD..$REBASED" | tr '\n' ' ')
    elif [ "$REBASED" != "$HEAD_REV" ]; then
        ALSO_REBASED=1
    fi
else
    echo "ERROR: Its stack's changes conflict with the indexed revision's in the files the C++ build reads, so it has no semantic analysis (which would be of the trunk's changes since the indexed revision too)."
    REBASED=""
fi

echo "Performing try-import::history step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
PUSH_REVS="$IMPORT_REVS" "$MOZSEARCH_PATH/scripts/import-try-push.sh" \
    "$GIT_ROOT" "$HISTORY_ROOT" "$GIT_BRANCH" "$NAME" "$IMPORT_REV" "$MAX_REVISIONS"

if [ -n "$REBASED" ]; then
    if [ "$PHASE" = history ]; then
        TUS=$(git -C "$GIT_ROOT" diff --name-only HEAD "$REBASED" | grep -cE '\.(c|cc|cpp|h|hpp)$' || true)
        printf 'REBASED=%q\nALSO_REBASED=%q\nTUS=%q\n' "$REBASED" "$ALSO_REBASED" "$TUS" > "$SEMANTIC_STATE"
        echo "Its semantic analysis is left for its semantic phase: $TUS translation units."
    else
        semantic_phase
    fi
fi
