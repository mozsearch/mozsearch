#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# A small C++ tree whose pages search with the pipeline-server's /query/ (see
# `config::SearchEndpoint`), and whose try pushes get semantic analysis (see
# import-try): its git repo has a commit per revision in revs/ (each the files
# it changes), with forged authors and dates for stable commit SHAs, and its
# history is the token-centric history.

echo "Performing setup::git-repository step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

MESSAGES=(
    "Add widgets, gadgets, and a widget user"
    "Let widgets shrink"
)
rm -rf "$GIT_ROOT"
mkdir -p "$GIT_ROOT"
pushd "$GIT_ROOT"
export GIT_AUTHOR_NAME="Searchfox"
export GIT_AUTHOR_EMAIL="searchfox@localhost"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
git init -b main
for REV in 1 2; do
    cp -r "$CONFIG_REPO/$TREE_NAME/revs/$REV/." .
    git add -A
    export GIT_AUTHOR_DATE="2025-04-0${REV}T12:00+0100"
    export GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE"
    git commit -m "${MESSAGES[$((REV - 1))]}"
done
popd

echo "Performing setup::build-history step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"

# (From scratch, since it's quick.)
rm -rf "$HISTORY_ROOT"
mkdir -p $HISTORY_ROOT/rev-summaries
for repo in syntax timeline; do
    mkdir -p $HISTORY_ROOT/$repo
    git init $HISTORY_ROOT/$repo
done
$MOZSEARCH_PATH/scripts/build-history.py $GIT_ROOT $HISTORY_ROOT

# The token journals' records sum to their tokens' instances (see
# check-token-counts), which token-timeline:'s counts need.
check-token-counts $HISTORY_ROOT --show 20

echo "Performing setup::build-commit-index step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
build-commit-index $GIT_ROOT $HISTORY_ROOT/commit-index

echo "Performing setup::metadata step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
# The hazard analysis' GC functions (UseWidget can GC; see annotate-gc), and
# the tests tree's bit of MDN's browser-compat-data (see the tests tree's
# setup), which a config repo's setup would download, for the tree's analysis
# and its try pushes' (see scripts/try-analyze-rest.sh, and build-try-delta's
# `cite_specs`).
ln -s -f $CONFIG_REPO/$TREE_NAME/gcFunctions.txt $INDEX_ROOT
ln -s -f $CONFIG_REPO/$TREE_NAME/allFunctions.txt $INDEX_ROOT
mkdir -p $INDEX_ROOT/bcd
cp $CONFIG_REPO/tests/bcd/data.json $INDEX_ROOT/bcd/data.json
