#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# The trydelta tree's semantic analysis of a try push (see import-try, which
# runs this with its environment, and tools/src/try_delta.rs): its stack
# rebased onto the indexed revision (here, the tree's head; REBASED, which
# import-try rebased; see rebase-try-push.sh) is compiled with the indexer (all of the tree's C++, since it's
# small; see build), its Rust indexed by rust-analyzer (the files whose
# analysis it can change; see try-analyze-rust.sh), its TypeScript, JS, pages
# and stylesheets analyzed as the tree's are (see try-analyze-typescript.sh
# and try-analyze-web.sh), and the rest of its files too, with its analysis'
# URLs and GC (see try-analyze-rest.sh), and its semantic delta built from
# that analysis.  Its steps are "semantic::" steps, which the push's page names if it fails (see
# try_import's `semantic_failure`).
#
# Usage: analyze-try NAME REBASED

NAME=$1
REBASED=$2
# (The tree's, before the build's environment below replaces it.)
TREE_INDEX_ROOT=$INDEX_ROOT

echo "Performing semantic::build step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
WORK=$(mktemp -d)
mkdir -p "$WORK/files" "$WORK/objdir" "$WORK/tip-analysis"
git -C "$GIT_ROOT" archive "$REBASED" | tar -x -C "$WORK/files"
INDEX_ROOT=$WORK FILES_ROOT=$WORK/files OBJDIR=$WORK/objdir \
    "$MOZSEARCH_PATH/scripts/indexer-setup.py" > "$WORK/config"
source "$WORK/config"
pushd "$WORK/files"
for SRC_FILE in $(find . -name '*.cpp' | sed 's#^\./##'); do
    mkdir -p "$(dirname "$WORK/objdir/$SRC_FILE")"
    MOZSEARCH_PLATFORM=linux64 $CXX "$SRC_FILE" -std=c++17 -I . -c -o "$WORK/objdir/${SRC_FILE%.cpp}.o" -Wall
done
popd
mv "$WORK/analysis" "$WORK/analysis-linux64"
git -C "$GIT_ROOT" diff --name-only HEAD "$REBASED" > "$WORK/changed.lst"

# (And its Rust, rust-analyzer's index of the files whose analysis it can
# change, as the tree's is; see build and try-analyze-rust.sh.)
echo "Performing semantic::rust step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
try-rust-files "$CONFIG_FILE" "$TREE_NAME" "$WORK/files" "$WORK/changed.lst" > "$WORK/rust-files"
if [ -s "$WORK/rust-files" ]; then
    printf '{ "rust-analyzer.server.extraEnv": { "CARGO_TARGET_DIR": "%s" } }\n' "$WORK/objdir/cargo" \
        > "$WORK/rust-analyzer.json"
    (cd "$WORK/files" && rust-analyzer scip . --config-path "$WORK/rust-analyzer.json" \
        --only-files "$WORK/rust-files" --output "$WORK/rust.scip")
    "$MOZSEARCH_PATH/scripts/try-analyze-rust.sh" "$CONFIG_FILE" "$TREE_NAME" "$WORK/files" \
        "$WORK/rust.scip" "$WORK/rust-files" "$WORK/analysis-linux64"
fi

# (Merged, like the tree's; see build.)
pushd "$WORK"
(cd analysis-linux64 && find . -type f | sed 's#^\./##') | while read -r FILE; do
    mkdir -p "$(dirname "tip-analysis/$FILE")"
    merge-analyses "analysis-linux64/$FILE" > "tip-analysis/$FILE"
done
popd

# (And its JS, which the compilation doesn't analyze: with scip-typescript,
# that of the projects at its head, as the tree's is (see build), and
# js-analyze's, the rest of it.)
echo "Performing semantic::typescript step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
(cd "$WORK/files" && find . -name '[tj]sconfig.json' | LC_ALL=C sort) > "$WORK/typescript-projects"
"$MOZSEARCH_PATH/scripts/try-analyze-typescript.sh" "$CONFIG_FILE" "$TREE_NAME" "$WORK/files" \
    "$WORK/typescript-projects" "$WORK/changed.lst" "$WORK/tip-analysis"
# (And its web analyses, as the tree's: its JS environments', its JS's and
# pages' markup's, its stylesheets', and its web-platform-tests' links.)
echo "Performing semantic::web step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
"$MOZSEARCH_PATH/scripts/try-analyze-web.sh" "$CONFIG_FILE" "$TREE_NAME" "$TREE_INDEX_ROOT" \
    "$WORK/files" "$WORK/changed.lst" "$WORK/tip-analysis"
# (And the rest of its analyses, as the tree's: its WebIDL's, IPDL's, TOML's,
# semantic analysis and moz.build files', and its analysis' URLs and GC.)
echo "Performing semantic::rest step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
"$MOZSEARCH_PATH/scripts/try-analyze-rest.sh" "$CONFIG_FILE" "$TREE_NAME" "$TREE_INDEX_ROOT" \
    "$WORK/files" "$WORK/objdir" "$WORK/changed.lst" "$WORK/tip-analysis"

echo "Performing semantic::delta step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
build-try-delta "$CONFIG_FILE" "$TREE_NAME" "$NAME" "$REBASED" "$WORK/tip-analysis"
rm -rf "$WORK"
